local function frame(name: string, parent: Instance, z: number): Frame
	local object = Instance.new("Frame")
	object.Name = name
	object.BorderSizePixel = 0
	object.Active = false
	object.Selectable = false
	object.ZIndex = z
	object.Parent = parent
	return object
end

function SkillArt.decorate(parent: GuiObject, accent: Color3, key: string?)
	key = key or "Y"
	-- CanvasGroup clips the moving stripes to the same rounded body as PlayerHUD.
	local root = Instance.new("CanvasGroup")
	root.Name = "PanelArtwork"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Active = false
	root.Selectable = false
	root.ZIndex = 1
	root.ClipsDescendants = true
	root.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 9)
	corner.Parent = root
	-- Keep the gradient on its own frame so it never tints the ink or white stripes.
	local background = frame("Background", root, 1)
	background.Size = UDim2.fromScale(1, 1)
	background.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	background.BackgroundTransparency = 0.04
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, accent:Lerp(Color3.fromRGB(6, 12, 13), 0.82)),
		ColorSequenceKeypoint.new(1, accent:Lerp(Color3.fromRGB(6, 12, 13), 0.68)),
	})
	gradient.Parent = background
	local stripePattern = frame("StripePattern", root, 2)
	stripePattern.Size = UDim2.fromScale(1, 1)
	stripePattern.BackgroundTransparency = 1
	local colors: {[string]: Color3} = {
		paper = Color3.fromRGB(245, 239, 220),
		white = Color3.fromRGB(255, 255, 255),
		ink = Color3.fromRGB(3, 11, 12),
		accent = accent,
	}
	local details: {{object: Frame, alpha: number}} = {}
	for _, shape in ipairs(SHAPES) do
		local variant = shape[10] :: string
		if variant ~= "both" and variant ~= key then continue end
		local group = shape[9] :: string
		local holder = group == "stripes" and stripePattern or root
		local detail = frame(shape[1] :: string, holder, 2)
		detail.AnchorPoint = Vector2.new(0.5, 0.5)
		local x = (shape[2] :: number) + (shape[4] :: number) / 2
		local y = (shape[3] :: number) + (shape[5] :: number) / 2
		detail.Position = UDim2.fromScale(x / REFERENCE, y / REFERENCE)
		detail.Size = UDim2.fromScale((shape[4] :: number) / REFERENCE, (shape[5] :: number) / REFERENCE)
		detail.BackgroundColor3 = colors[shape[6] :: string]
		detail.BackgroundTransparency = shape[7] :: number
		detail.Rotation = shape[8] :: number
		local radius = shape[11] :: number
		if radius > 0 then
			local rounding = Instance.new("UICorner")
			rounding.CornerRadius = UDim.new(radius, 0)
			rounding.Parent = detail
		end
		table.insert(details, {object = detail, alpha = shape[7] :: number})
	end
	local alive = true
	local lastMode, lastHover = "", false
	local previousTime, stripePhase = 0, 0
	local self = {Root = root}

	function self:Step(elapsed: number, mode: string, hover: boolean)
		if not alive then return end
		local dt = math.clamp(elapsed - previousTime, 0, 0.1)
		previousTime = elapsed
		local unavailable = mode == "unavailable"
		-- Keep the same animated backslash rhythm as PlayerHUD.
		stripePhase = (stripePhase + dt * 9 * (hover and 3.2 or 1) * (unavailable and 0.25 or 1)) % 26
		stripePattern.Position = UDim2.fromScale(stripePhase / REFERENCE, 0)
		if mode ~= lastMode or hover ~= lastHover then
			lastMode, lastHover = mode, hover
			local intensity = unavailable and 0.38 or (mode == "cooldown" and 0.65 or (hover and 1.1 or 1))
			for _, detail in ipairs(details) do
				detail.object.BackgroundTransparency = math.clamp(1 - (1 - detail.alpha) * intensity, 0, 1)
			end
		end
	end

	function self:Destroy()
		if not alive then return end
		alive = false
		table.clear(details)
		root:Destroy()
	end
	return self
end

return SkillArt
