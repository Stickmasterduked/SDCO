--[[
	Katana skills (Z: Lumen Rush, X: Moonfall Crescent). Called by
	AnimationData after the katana moveset is built.

	The pose keys live in KatanaSkillPoses, generated by tools/katana/moves.py
	from blade specs (both fists solved onto the handle, feet on the floor).
	Unlike the katana M1s these are authored at their final timing and size:
	no retime, no exaggeration pass, so the Hit marker lands exactly where
	the blade crosses the target.

	Baking: the same smooth curve as every other clip (env.detail), with
	springs only on the head and legs, then a small stagger so the legs and
	head settle a beat after the body. The torso, arms and blade stay exact,
	which keeps the cut on its contact frame.

	Clip extras:
	  katana = true, ik = 1  (blade on the right hand, left hand on the grip)
	  skill  = true          (the client's generic swing/hit hooks skip it;
	                          KatanaFX drives this clip's effects instead)
]]

local Poses = require(script.KatanaSkillPoses)

-- negative leads, positive follows (seconds)
local DELAYS = { Torso = 0, RightArm = 0, LeftArm = 0, Katana = 0, RightLeg = 0.012, LeftLeg = 0.02, Head = 0.035 }
local SPRINGS = { Head = { 6, 0.38 }, RightLeg = { 9, 0.5 }, LeftLeg = { 9, 0.5 } }
local STEP = 1 / 120

local function stagger(clip)
	local keys = clip.keys
	local length = clip.length
	local tail = 0
	for _, delay in pairs(DELAYS) do
		tail = math.max(tail, delay)
	end
	local function sampleJoint(joint, t)
		t = math.clamp(t, 0, length)
		local lo, hi = 1, #keys
		while hi - lo > 1 do
			local mid = (lo + hi) // 2
			if keys[mid].t <= t then
				lo = mid
			else
				hi = mid
			end
		end
		local a, b = keys[lo], keys[hi]
		local va, vb = a.pose[joint], b.pose[joint]
		local alpha = b.t > a.t and math.clamp((t - a.t) / (b.t - a.t), 0, 1) or 0
		local v = {}
		for i = 1, 6 do
			v[i] = (va[i] or 0) + ((vb[i] or 0) - (va[i] or 0)) * alpha
		end
		return v
	end
	local total = length + tail
	local out = {}
	for i = 0, math.ceil(total / STEP) do
		local t = math.min(i * STEP, total)
		local p = {}
		for joint in pairs(keys[1].pose) do
			p[joint] = sampleJoint(joint, t - (DELAYS[joint] or 0))
		end
		table.insert(out, { t = t, ease = "Linear", pose = p })
	end
	local result = table.clone(clip)
	result.keys = out
	result.length = total
	return result
end

return function(Data, env)
	for name, c in pairs(Poses) do
		local clip = {
			length = c.length,
			recover = c.recover,
			markers = table.clone(c.markers),
			priority = "Action",
			group = "action",
			ik = 1,
			katana = true,
			skill = true,
			keys = {},
		}
		for _, key in ipairs(c.keys) do
			table.insert(clip.keys, { t = key.t, ease = "Linear", pose = key.pose })
		end
		Data[name] = stagger(env.detail(clip, SPRINGS, env.fps))
		env.detailed[name] = true
	end
end
