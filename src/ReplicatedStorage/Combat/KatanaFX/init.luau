--[[
	Katana skill VFX (client only). Plays the score in KatanaFXData
	(generated by tools/katana/fxscore.py, which also renders previews of it).

	Every layer has a purpose, a direction and a lifespan, and is anchored to
	a frame resolved when it spawns:
	  tip / root / feet  the attacker's blade tip, body, the floor under them
	  cut / ground       an impact: the cut plane at the contact point, and
	                     the floor under it
	  release / proj     Moonfall Crescent's launch point and the travelling
	                     crescent itself

	Building blocks (no meshes needed):
	  strokes   tapered polylines (crescents, rays, rings, wisps, wakes) made
	            of camera-facing Beams, one chain per skin: a crisp white
	            edge, a translucent body set in behind it, a soft spill
	  sprites   single additive particles (flashes, star flares, prism halo,
	            the crescent silhouette)
	  sparks / dust  ParticleEmitter bursts
	  trails    Trails on the blade: ribbons that trace the real swing

	A session follows one playing skill clip on one body. It reads the
	track's own time, so effects stay locked to the animation (hit-stop
	pauses them too), and it tears everything down if the clip is cut short.

	API (CombatClient):
	  KatanaFX.begin(model, track, clipName)        a skill clip started
	  KatanaFX.handles(kind, info)                  is this effect ours?
	  KatanaFX.impact(kind, position, attacker, defender, info) -> amount
	  KatanaFX.cancel(model)                        stop a body's session now
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")

local Combat = script.Parent
local Config = require(Combat.Config)
local CameraFX = require(Combat.CameraFX)
local Data = require(script.KatanaFXData)

local KatanaFX = {}

local FLAT = Vector3.new(1, 0, 1)
local random = Random.new()
local localPlayer = Players.LocalPlayer

------------------------------------------------------------------------
-- Textures: the custom set (Config.KatanaTextures, generated by
-- tools/katana/textures.py) or, until it's uploaded, the closest existing one.

local function textureFor(name)
	local custom = Config.KatanaTextures and Config.KatanaTextures[name]
	if type(custom) == "string" and custom ~= "" then
		return custom
	end
	local T = Config.Textures or {}
	local fallback = {
		glow = T.softGlow or T.glow,
		core = T.glow or T.softGlow,
		star = T.spark,
		burst = T.spark,
		prism = T.ring,
		streak = T.sparkStreak,
		spark = T.sparkStreak or T.spark,
		glint = T.spark,
		dust = T.dust or T.smoke,
		-- flipbooks fall back to the existing 4x4 flipbooks
		explosion = T.impact or T.hitImpact,
		smoke = T.smoke or T.dust,
		slash = T.hitImpact or T.impact,
		shock = T.shockwave or T.ring,
		spike = T.spark,
		energy = T.softGlow or T.glow,
		-- no stand-in: skipped until uploaded
		crescent = nil,
		-- beam skins: a plain (solid) beam until the ribbons are uploaded
		ribbonCore = "",
		ribbonFlow = "",
		ribbonSoft = "",
		bladeTrail = "",
	}
	return fallback[name]
end

-- uploaded sprites are fetched up front so the first cast doesn't pop in
task.spawn(function()
	local assets = {}
	for _, id in pairs(Config.KatanaTextures or {}) do
		if type(id) == "string" and id ~= "" then
			local decal = Instance.new("Decal")
			decal.Texture = id
			table.insert(assets, decal)
		end
	end
	if #assets > 0 then
		pcall(function()
			game:GetService("ContentProvider"):PreloadAsync(assets)
		end)
	end
end)

local SKIN_TEXTURE = { core = "ribbonCore", flow = "ribbonFlow", soft = "ribbonSoft" }
-- without the soft ribbon, a solid spill skin would read as a slab: thin it
local SOLID_ALPHA = { core = 1, flow = 0.8, soft = 0.45 }

------------------------------------------------------------------------
-- Small helpers

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- keys: { {t, value}, ... } with value a number or an RGB triple
local function ev(keys, t)
	if type(keys) ~= "table" then
		return keys
	end
	local n = #keys
	if n == 0 then
		return nil
	end
	if t <= keys[1][1] then
		return keys[1][2]
	end
	for i = 1, n - 1 do
		local a, b = keys[i], keys[i + 1]
		if t <= b[1] then
			local alpha = b[1] > a[1] and (t - a[1]) / (b[1] - a[1]) or 1
			local va, vb = a[2], b[2]
			if type(va) == "table" then
				return {
					va[1] + (vb[1] - va[1]) * alpha,
					va[2] + (vb[2] - va[2]) * alpha,
					va[3] + (vb[3] - va[3]) * alpha,
				}
			end
			return va + (vb - va) * alpha
		end
	end
	return keys[n][2]
end

local function numberSequence(keys, map)
	if type(keys) ~= "table" then
		return NumberSequence.new(map and map(keys) or keys)
	end
	local points = {}
	local lastT = -1
	for i, k in ipairs(keys) do
		local t = math.clamp(k[1], 0, 1)
		if i == 1 then
			t = 0
		end
		if t <= lastT then
			t = math.min(1, lastT + 1e-3)
		end
		lastT = t
		table.insert(points, NumberSequenceKeypoint.new(t, map and map(k[2]) or k[2]))
	end
	if points[#points].Time < 1 then
		table.insert(points, NumberSequenceKeypoint.new(1, points[#points].Value))
	else
		points[#points] = NumberSequenceKeypoint.new(1, points[#points].Value)
	end
	return NumberSequence.new(points)
end

local function colorSequence(keys)
	if type(keys[1]) == "number" then
		return ColorSequence.new(rgb(keys))
	end
	local points = {}
	local lastT = -1
	for i, k in ipairs(keys) do
		local t = i == 1 and 0 or math.clamp(k[1], 0, 1)
		if t <= lastT then
			t = math.min(1, lastT + 1e-3)
		end
		lastT = t
		table.insert(points, ColorSequenceKeypoint.new(t, rgb(k[2])))
	end
	if points[#points].Time < 1 then
		table.insert(points, ColorSequenceKeypoint.new(1, points[#points].Value))
	else
		points[#points] = ColorSequenceKeypoint.new(1, points[#points].Value)
	end
	return ColorSequence.new(points)
end

local function setBrightness(object, value)
	pcall(function()
		object.Brightness = value
	end)
end

local function lerpColor(a, b, t)
	return { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t }
end

local function hue(t)
	local c = Color3.fromHSV(t % 1, 0.55, 1)
	return { c.R * 255, c.G * 255, c.B * 255 }
end

local fxFolder
local function folder()
	if not fxFolder or not fxFolder.Parent then
		fxFolder = Workspace:FindFirstChild("CombatFX")
		if not fxFolder then
			fxFolder = Instance.new("Folder")
			fxFolder.Name = "CombatFX"
			fxFolder.Parent = Workspace
		end
	end
	return fxFolder
end

-- World-space attachments live on one invisible anchored part.
local anchorPart
local function anchor()
	if not anchorPart or not anchorPart.Parent then
		anchorPart = Instance.new("Part")
		anchorPart.Name = "KatanaFXAnchor"
		anchorPart.Anchored = true
		anchorPart.CanCollide = false
		anchorPart.CanQuery = false
		anchorPart.CanTouch = false
		anchorPart.Transparency = 1
		anchorPart.Size = Vector3.new(0.05, 0.05, 0.05)
		anchorPart.CFrame = CFrame.identity
		anchorPart.Parent = folder()
	end
	return anchorPart
end

local function attachmentAt(position)
	local a = Instance.new("Attachment")
	a.Position = position
	a.Parent = anchor()
	return a
end

local function groundParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	for _, model in ipairs(game:GetService("CollectionService"):GetTagged("Combatant")) do
		table.insert(ignore, model)
	end
	table.insert(ignore, folder())
	params.FilterDescendantsInstances = ignore
	return params
end

local function floorBelow(position, depth)
	local hit = Workspace:Raycast(position + Vector3.new(0, 1, 0), Vector3.new(0, -(depth or 12), 0), groundParams())
	return hit and hit.Position or nil
end

local function flatUnit(v, fallback)
	v = v * FLAT
	if v.Magnitude < 1e-3 then
		return fallback or Vector3.new(0, 0, -1)
	end
	return v.Unit
end

-- frame from an origin and two axes (X, then Y orthogonalised against it)
local function frameXY(origin, x, y)
	x = x.Magnitude > 1e-4 and x.Unit or Vector3.xAxis
	y = y - x * y:Dot(x)
	if y.Magnitude < 1e-4 then
		y = math.abs(x.Y) < 0.9 and Vector3.yAxis or Vector3.zAxis
		y = (y - x * y:Dot(x))
	end
	y = y.Unit
	return CFrame.fromMatrix(origin, x, y, x:Cross(y))
end

-- Turns a frame about its X axis so its plane faces the camera by `amount`
-- (0 = as authored, 1 = fully facing). The plane is two-sided, so it takes
-- the shorter way round.
local function billboard(frame, amount)
	if not amount or amount <= 0 then
		return frame
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return frame
	end
	local x = frame.XVector
	local toCamera = camera.CFrame.Position - frame.Position
	toCamera -= x * toCamera:Dot(x)
	if toCamera.Magnitude < 1e-3 then
		return frame
	end
	toCamera = toCamera.Unit
	-- the plane is two-sided: measure from whichever face is toward the camera
	local z = frame.ZVector
	if z:Dot(toCamera) < 0 then
		z = -z
	end
	local angle = math.atan2(z:Cross(toCamera):Dot(x), z:Dot(toCamera))
	return frame * CFrame.fromAxisAngle(Vector3.xAxis, angle * amount)
end

------------------------------------------------------------------------
-- Live updaters: anything animated per frame registers a function that
-- returns false when it's done.

local live = {}

local function run(step, cleanup)
	table.insert(live, { step = step, cleanup = cleanup })
end

------------------------------------------------------------------------
-- Chains: a polyline drawn as camera-facing beams (one skin of a stroke)

local Chain = {}
Chain.__index = Chain

local function newChain(count, skin)
	local self = setmetatable({ atts = {}, beams = {}, count = count, skin = skin }, Chain)
	local texName = SKIN_TEXTURE[skin.tex or "core"] or "ribbonCore"
	local texture = textureFor(texName)
	self.solid = texture == "" or texture == nil
	for i = 1, count do
		self.atts[i] = attachmentAt(Vector3.zero)
	end
	for i = 1, count - 1 do
		local beam = Instance.new("Beam")
		beam.Attachment0 = self.atts[i]
		beam.Attachment1 = self.atts[i + 1]
		beam.FaceCamera = true
		beam.Segments = 1
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Color = ColorSequence.new(rgb(skin.color))
		beam.Texture = texture or ""
		if skin.flow then
			beam.TextureMode = Enum.TextureMode.Static
			beam.TextureLength = 6
			beam.TextureSpeed = skin.flow
		else
			beam.TextureMode = Enum.TextureMode.Stretch
			beam.TextureLength = 1
			beam.TextureSpeed = 0
		end
		beam.ZOffset = skin.zoffset or 0
		beam.Transparency = NumberSequence.new(1)
		beam.Width0 = 0
		beam.Width1 = 0
		setBrightness(beam, skin.brightness or 1)
		beam.Parent = anchor()
		self.beams[i] = beam
	end
	return self
end

-- points / widths / alphas / colors (colors optional) per point
function Chain:set(points, widths, alphas, colors)
	local n = math.min(#points, self.count)
	local alphaScale = self.skin.alpha or 1
	if self.solid then
		alphaScale *= SOLID_ALPHA[self.skin.tex or "core"] or 1
	end
	for i = 1, self.count do
		local p = points[math.min(i, n)]
		self.atts[i].Position = p
	end
	for i = 1, self.count - 1 do
		local beam = self.beams[i]
		if i < n then
			local a0 = math.clamp((alphas[i] or 0) * alphaScale, 0, 1)
			local a1 = math.clamp((alphas[i + 1] or 0) * alphaScale, 0, 1)
			beam.Width0 = widths[i] or 0
			beam.Width1 = widths[i + 1] or 0
			beam.Transparency = NumberSequence.new(1 - a0, 1 - a1)
			if colors then
				local c0, c1 = colors[i], colors[i + 1]
				beam.Color = ColorSequence.new(rgb(c0), rgb(c1))
			end
		else
			beam.Width0 = 0
			beam.Width1 = 0
			beam.Transparency = NumberSequence.new(1)
		end
	end
end

function Chain:destroy()
	for _, beam in ipairs(self.beams) do
		beam:Destroy()
	end
	for _, a in ipairs(self.atts) do
		a:Destroy()
	end
	table.clear(self.beams)
	table.clear(self.atts)
end

------------------------------------------------------------------------
-- Stroke geometry (identical to tools/katana/preview.py)

-- width profile along s = 0..1: tapered at both ends, peak where the
-- exponents put it (a: tail end, b: head end)
local function profile(s, taper)
	if not taper then
		return 1
	end
	local a, b = taper[1], taper[2]
	if s <= 0 or s >= 1 then
		return 0
	end
	local peak = a / (a + b)
	return ((s / peak) ^ a) * (((1 - s) / (1 - peak)) ^ b)
end

-- arc: apex at the frame origin + `apexY`, centre below it on -Y
local function arcPoint(radius, theta, apexY)
	local c, s = math.cos(theta), math.sin(theta)
	return Vector3.new(c * radius, s * radius - radius + apexY, 0), Vector3.new(c, s, 0)
end

local function chordToArc(chord, sagitta)
	sagitta = math.max(sagitta, 0.05)
	local radius = (chord * chord / 4 + sagitta * sagitta) / (2 * sagitta)
	local half = math.asin(math.clamp(chord / (2 * radius), -1, 1))
	return radius, math.deg(2 * half)
end

-- Local points along a shape for s in [s0, s1]: positions, outward normals
-- and the absolute s of each sample.
local function shapePoints(layer, u, s0, s1, count)
	local positions, normals, ss = {}, {}, {}
	local shape = layer.shape
	local offset = layer.offset and Vector3.new(layer.offset[1], layer.offset[2], layer.offset[3]) or Vector3.zero
	if layer.move then
		offset += Vector3.new(layer.move[1], layer.move[2], layer.move[3]) * u
	end
	if shape == "arc" or shape == "chord" then
		local radius, span, apexY
		if shape == "chord" then
			local sag = ev(layer.sagitta, u)
			radius, span = chordToArc(layer.chord, sag)
			apexY = sag
		else
			radius = layer.radius * (layer.radiusScale and ev(layer.radiusScale, u) or 1)
			span = layer.span
			apexY = 0
		end
		local mid = math.rad(layer.mid or 90)
		local half = math.rad(span) / 2
		for i = 0, count - 1 do
			local s = s0 + (s1 - s0) * i / (count - 1)
			local theta = mid + half - s * 2 * half
			local p, n = arcPoint(radius, theta, apexY)
			table.insert(positions, p + offset)
			table.insert(normals, n)
			table.insert(ss, s)
		end
	elseif shape == "ring" then
		local radius = ev(layer.radius, u)
		local ground = layer.plane == "ground"
		for i = 0, count - 1 do
			local s = s0 + (s1 - s0) * i / (count - 1)
			local theta = s * math.pi * 2
			local c, sn = math.cos(theta), math.sin(theta)
			local n = ground and Vector3.new(c, 0, sn) or Vector3.new(c, sn, 0)
			table.insert(positions, n * radius + offset)
			table.insert(normals, n)
			table.insert(ss, s)
		end
	elseif shape == "line" then
		local pts = layer.points
		local segments = #pts - 1
		for i = 0, count - 1 do
			local s = s0 + (s1 - s0) * i / (count - 1)
			local x = s * segments
			local k = math.clamp(math.floor(x), 0, segments - 1)
			local f = x - k
			local a, b = pts[k + 1], pts[k + 2]
			local p = Vector3.new(a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f, a[3] + (b[3] - a[3]) * f)
			local dir = Vector3.new(b[1] - a[1], b[2] - a[2], b[3] - a[3])
			local n = dir.Magnitude > 1e-4 and Vector3.new(-dir.Unit.Y, dir.Unit.X, 0) or Vector3.yAxis
			table.insert(positions, p + offset)
			table.insert(normals, n)
			table.insert(ss, s)
		end
	end
	return positions, normals, ss
end

-- A stroke: the shape's visible stretch drawn with each skin.
local function strokeLayer(layer, resolveFrame, duration)
	local count = (layer.segments or 16) + 1
	local chains = {}
	for i, skin in ipairs(layer.skins) do
		chains[i] = newChain(count, skin)
	end
	local start = os.clock()
	local closed = layer.shape == "ring"
	local function cleanup()
		for _, chain in ipairs(chains) do
			chain:destroy()
		end
	end
	run(function()
		local age = os.clock() - start
		local u = math.clamp(age / duration, 0, 1)
		local base = resolveFrame()
		if age >= duration or not base then
			cleanup()
			return false
		end
		local frame = billboard(base, layer.billboard)
		local head = layer.reveal and ev(layer.reveal, u) or 1
		local tail = (layer.erase and layer.eraseMode ~= "centre") and ev(layer.erase, u) or 0
		if closed then
			head, tail = 1, 0
		end
		if head - tail < 1e-3 then
			for _, chain in ipairs(chains) do
				chain:set({ frame.Position }, { 0 }, { 0 })
			end
			return true
		end
		local positions, normals, ss = shapePoints(layer, u, tail, head, count)
		local width = layer.width * (layer.widthScale and ev(layer.widthScale, u) or 1)
		local alpha = ev(layer.alpha, u)
		local gap = layer.eraseMode == "centre" and layer.erase and ev(layer.erase, u) or 0
		for k, skin in ipairs(layer.skins) do
			local pts, ws, as, cs = {}, {}, {}, nil
			if layer.rainbow then
				cs = {}
			end
			for i = 1, #positions do
				local s = ss[i]
				local w = width * (closed and 1 or profile(s, layer.taper))
				if not closed then
					-- a stroke still drawing in (or being erased) keeps a pointed end
					if head < 1 then
						w *= math.clamp((head - s) / 0.12, 0, 1) ^ 0.6
					end
					if tail > 0 then
						w *= math.clamp((s - tail) / 0.12, 0, 1) ^ 0.6
					end
				end
				local inset = skin.inset or 0
				local local_ = positions[i] - normals[i] * inset * w
				pts[i] = frame:PointToWorldSpace(local_)
				ws[i] = w * skin.w
				local a = alpha
				if gap > 0 then
					a *= math.clamp((math.abs(s - 0.5) - gap / 2) / 0.06, 0, 1)
				end
				as[i] = a
				if cs then
					cs[i] = lerpColor(hue(s), skin.color, 0.25)
				end
			end
			chains[k]:set(pts, ws, as, cs)
		end
		return true
	end, cleanup)
end

------------------------------------------------------------------------
-- Sprites, sparks, dust, lights, sounds

-- Screen rotation (degrees) of a world direction at a point. Particle
-- Rotation turns clockwise on screen; flip this if flares that should run
-- along a cut cross it instead.
local ROTATION_SIGN = 1

local function screenAngle(position, direction)
	local camera = Workspace.CurrentCamera
	if not camera then
		return 0
	end
	local a = camera:WorldToViewportPoint(position)
	local b = camera:WorldToViewportPoint(position + direction)
	return ROTATION_SIGN * math.deg(math.atan2(b.Y - a.Y, b.X - a.X))
end

local function spriteLayer(layer, frame, follow)
	local texture = textureFor(layer.sprite)
	if not texture or texture == "" then
		return
	end
	local offset = layer.offset and Vector3.new(layer.offset[1], layer.offset[2], layer.offset[3]) or Vector3.zero
	local position = frame:PointToWorldSpace(offset)
	local attachment = attachmentAt(position)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = texture
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(layer.life)
	emitter.Speed = NumberRange.new(0)
	emitter.LockedToPart = true
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Size = numberSequence(layer.size)
	emitter.Transparency = numberSequence(layer.transparency)
	emitter.Color = colorSequence(layer.color)
	emitter.ZOffset = layer.zoffset or 1
	local rotation = layer.rotation or 0
	if layer.alignX then
		rotation += screenAngle(position, frame.XVector)
	elseif layer.alignY then
		-- the sprite's up (screen -Y) along the frame's Y
		rotation += screenAngle(position, frame.YVector) + 90
	end
	emitter.Rotation = NumberRange.new(rotation)
	emitter.RotSpeed = NumberRange.new(layer.spin or 0)
	setBrightness(emitter, layer.brightness or 1)
	emitter.Parent = attachment
	emitter:Emit(1)
	if follow then
		local start = os.clock()
		run(function()
			local f = follow()
			if not f or os.clock() - start > layer.life then
				return false
			end
			attachment.Position = f:PointToWorldSpace(offset)
			return true
		end)
	end
	Debris:AddItem(attachment, layer.life + 0.1)
end

local function sparksLayer(layer, frame)
	local texture = textureFor(layer.sprite or "spark")
	if not texture then
		return
	end
	local dir = frame:VectorToWorldSpace(Vector3.new(layer.dir[1], layer.dir[2], layer.dir[3]))
	local function burst(direction, count)
		if count <= 0 or direction.Magnitude < 1e-4 then
			return
		end
		local attachment = attachmentAt(frame.Position)
		-- emitters shoot along the attachment's up axis
		local up = direction.Unit
		local right = math.abs(up.Y) < 0.95 and up:Cross(Vector3.yAxis).Unit or up:Cross(Vector3.xAxis).Unit
		attachment.CFrame = CFrame.fromMatrix(frame.Position, right, up)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = texture
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(layer.life[1], layer.life[2])
		emitter.Speed = NumberRange.new(layer.speed[1], layer.speed[2])
		emitter.SpreadAngle = Vector2.new(layer.spread, layer.spread)
		emitter.Drag = layer.drag or 0
		emitter.Acceleration = Vector3.zero
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
		emitter.LightEmission = 1
		emitter.LightInfluence = 0
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, layer.size),
			NumberSequenceKeypoint.new(0.6, layer.size * 0.7),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.7, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Color = ColorSequence.new(rgb(layer.color), rgb(layer.tint or layer.color))
		emitter.Squash = NumberSequence.new(-1.2)
		setBrightness(emitter, 3)
		emitter.Parent = attachment
		emitter:Emit(count)
		Debris:AddItem(attachment, layer.life[2] + 0.2)
	end
	if layer.mirror then
		burst(dir, math.ceil(layer.count / 2))
		burst(-dir, math.floor(layer.count / 2))
	else
		burst(dir, layer.count)
	end
end

local function dustLayer(layer, frame)
	local texture = textureFor("dust")
	local floor = floorBelow(frame.Position + Vector3.new(0, 2, 0), 8)
	if not texture or not floor then
		return
	end
	local attachment = attachmentAt(floor + Vector3.new(0, 0.3, 0))
	local up = Vector3.yAxis
	if layer.back then
		-- kicked back off the launching foot
		up = (Vector3.yAxis * 0.5 + frame.ZVector).Unit
	end
	local right = up:Cross(Vector3.zAxis).Magnitude > 1e-3 and up:Cross(Vector3.zAxis).Unit or Vector3.xAxis
	attachment.CFrame = CFrame.fromMatrix(attachment.Position, right, up)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = texture
	pcall(function()
		emitter.FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4
		emitter.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
	end)
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.45, 0.8)
	emitter.Speed = NumberRange.new(layer.speed * 0.5, layer.speed)
	emitter.SpreadAngle = Vector2.new(layer.spread, layer.spread)
	emitter.Drag = 5
	emitter.Acceleration = Vector3.new(0, 2, 0)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-60, 60)
	emitter.LightInfluence = 0.6
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 3.8) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	emitter.Color = ColorSequence.new(Color3.fromRGB(206, 202, 222))
	emitter.Parent = attachment
	emitter:Emit(layer.count)
	Debris:AddItem(attachment, 1.2)
end

------------------------------------------------------------------------
-- Particle bursts: the real VFX (flipbook explosions, smoke, slash flashes,
-- flat ground shockwaves, sparks). Every look in the score is one of these.

local ORIENTATION = {
	camera = Enum.ParticleOrientation.FacingCamera,
	upright = Enum.ParticleOrientation.FacingCameraWorldUp,
	velocity = Enum.ParticleOrientation.VelocityParallel,
	flat = Enum.ParticleOrientation.VelocityPerpendicular,
}

local function range2(v, default)
	if type(v) == "table" then
		return NumberRange.new(v[1], v[2] or v[1])
	end
	return NumberRange.new(v or default or 0)
end

-- Builds a ParticleEmitter from a layer's look (not emitting yet).
local function makeEmitter(layer, texture)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = texture
	emitter.Rate = layer.rate or 0
	emitter.Lifetime = range2(layer.life, 0.5)
	emitter.Speed = range2(layer.speed, 0)
	emitter.SpreadAngle = Vector2.new(layer.spread or 0, layer.spread or 0)
	emitter.Drag = layer.drag or 0
	local acc = layer.accel
	emitter.Acceleration = acc and Vector3.new(acc[1], acc[2], acc[3]) or Vector3.zero
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Orientation = ORIENTATION[layer.orientation or "camera"]
	emitter.Rotation = range2(layer.rotation, 0)
	emitter.RotSpeed = range2(layer.spin, 0)
	emitter.Size = numberSequence(layer.size)
	emitter.Transparency = numberSequence(layer.transparency or 0)
	emitter.Color = colorSequence(layer.color or { 255, 255, 255 })
	emitter.LightEmission = layer.emission or 1
	emitter.LightInfluence = 0
	emitter.ZOffset = layer.zoffset or 0
	emitter.LockedToPart = layer.locked == true
	if layer.squash then
		emitter.Squash = numberSequence(layer.squash)
	end
	if layer.flip then
		pcall(function()
			emitter.FlipbookLayout = layer.flip == "2x2" and Enum.ParticleFlipbookLayout.Grid2x2 or Enum.ParticleFlipbookLayout.Grid4x4
			emitter.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
		end)
	end
	setBrightness(emitter, layer.brightness or 1)
	return emitter
end

-- Where a burst comes from: an attachment aimed along `dir` (emitters shoot
-- along their Top), or a ball of `radius` for volume / inward bursts.
local function emitterHolder(layer, frame)
	local offset = layer.offset and Vector3.new(layer.offset[1], layer.offset[2], layer.offset[3]) or Vector3.zero
	local position = frame:PointToWorldSpace(offset)
	local dir = layer.dir and frame:VectorToWorldSpace(Vector3.new(layer.dir[1], layer.dir[2], layer.dir[3])) or Vector3.yAxis
	if layer.worldUp then
		dir = Vector3.yAxis
	end
	dir = dir.Magnitude > 1e-4 and dir.Unit or Vector3.yAxis
	local right = math.abs(dir.Y) < 0.95 and dir:Cross(Vector3.yAxis).Unit or dir:Cross(Vector3.xAxis).Unit
	local cframe = CFrame.fromMatrix(position, right, dir)
	if layer.radius then
		local part = Instance.new("Part")
		part.Name = "KatanaFXBurst"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.one * layer.radius * 2
		part.CFrame = cframe
		part.Parent = folder()
		return part, function(emitter)
			pcall(function()
				emitter.Shape = Enum.ParticleEmitterShape.Sphere
				emitter.ShapeStyle = layer.surface and Enum.ParticleEmitterShapeStyle.Surface or Enum.ParticleEmitterShapeStyle.Volume
				emitter.ShapeInOut = layer.inward and Enum.ParticleEmitterShapeInOut.Inward or Enum.ParticleEmitterShapeInOut.Outward
			end)
		end
	end
	local attachment = attachmentAt(position)
	attachment.CFrame = cframe
	return attachment, nil
end

local function burstLayer(layer, frame)
	local texture = textureFor(layer.sprite)
	if not texture or texture == "" then
		return
	end
	local holder, shape = emitterHolder(layer, frame)
	local emitter = makeEmitter(layer, texture)
	if shape then
		shape(emitter)
	end
	if layer.alignX and frame then
		local r = layer.rotation or 0
		local base = type(r) == "table" and r[1] or r
		local a = math.deg(0)
		local camera = Workspace.CurrentCamera
		if camera then
			local p0 = camera:WorldToViewportPoint(frame.Position)
			local p1 = camera:WorldToViewportPoint(frame.Position + frame.XVector)
			a = math.deg(math.atan2(p1.Y - p0.Y, p1.X - p0.X))
		end
		local spread = type(r) == "table" and (r[2] - r[1]) or 0
		emitter.Rotation = NumberRange.new(base + a, base + a + spread)
	end
	emitter.Parent = holder
	emitter:Emit(layer.count or 1)
	local life = type(layer.life) == "table" and (layer.life[2] or layer.life[1]) or layer.life or 1
	Debris:AddItem(holder, life + 0.3)
end

local function lightLayer(layer, resolveFrame)
	local frame = resolveFrame()
	if not frame then
		return
	end
	local attachment = attachmentAt(frame.Position)
	local light = Instance.new("PointLight")
	light.Color = rgb(layer.color)
	light.Shadows = false
	light.Parent = attachment
	local start = os.clock()
	run(function()
		local u = (os.clock() - start) / layer.life
		local f = resolveFrame()
		if u >= 1 or not f then
			attachment:Destroy()
			return false
		end
		attachment.Position = f.Position
		light.Brightness = ev(layer.brightness, u)
		light.Range = ev(layer.range, u)
		return true
	end, function()
		attachment:Destroy()
	end)
end

local function playSound(name, position, volume, pitch)
	local list = Config.Sounds[name]
	if not list or #list == 0 then
		return
	end
	local attachment = attachmentAt(position)
	local sound = Instance.new("Sound")
	sound.SoundId = list[random:NextInteger(1, #list)]
	sound.Volume = volume or 0.6
	sound.PlaybackSpeed = (pitch or 1) * random:NextNumber(0.97, 1.03)
	sound.RollOffMinDistance = 10
	sound.RollOffMaxDistance = 140
	sound.Parent = attachment
	sound:Play()
	Debris:AddItem(attachment, 5)
end
KatanaFX.sound = playSound

-- A flurry: slash flashes tearing across the target one after another,
-- each with a spark spit, a hit sound, a flinch and a camera tick.
local PoseAnimatorModule
local function flurryLayer(layer, frame, attacker, defender)
	local rng = Random.new()
	for i = 1, layer.count do
		task.delay((i - 1) * layer.every * rng:NextNumber(0.7, 1.3), function()
			local jitter = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.6, 1), rng:NextNumber(-1, 1)) * layer.spread
			local at = frame * CFrame.new(jitter)
			local size = rng:NextNumber(layer.size[1], layer.size[2])
			local angle = rng:NextNumber(0, 360)
			burstLayer({
				sprite = layer.sprite, flip = "4x4", count = 1, life = layer.life,
				size = { { 0, size * 0.85 }, { 1, size * 1.2 } }, transparency = { { 0, 0 }, { 0.7, 0.1 }, { 1, 1 } },
				color = layer.color or { 255, 255, 255 }, rotation = angle, brightness = layer.brightness or 3, zoffset = 2,
			}, at)
			burstLayer({
				sprite = "core", count = 1, life = 0.1, size = { { 0, size * 0.18 }, { 0.3, size * 0.32 }, { 1, size * 0.1 } },
				transparency = { { 0, 0.1 }, { 1, 1 } }, color = { 255, 255, 255 }, brightness = 4, zoffset = 2,
			}, at)
			burstLayer({
				sprite = "spark", count = layer.sparks or 6, life = { 0.2, 0.45 }, speed = { 30, 70 }, spread = 180,
				drag = 6, orientation = "velocity", size = { { 0, 0.35 }, { 1, 0 } }, transparency = { { 0, 0 }, { 1, 1 } },
				color = { { 0, { 255, 255, 255 } }, { 1, layer.tint or { 200, 176, 255 } } }, brightness = 3, squash = -1.2,
			}, at)
			playSound(layer.sound or "KatanaSwing", at.Position, 0.55, rng:NextNumber(1.1, 1.5))
			if defender and typeof(defender) == "Instance" and defender.Parent then
				PoseAnimatorModule = PoseAnimatorModule or require(Combat.PoseAnimator)
				pcall(PoseAnimatorModule.kick, defender, "Torso", Vector3.new(rng:NextNumber(-500, 500), rng:NextNumber(-400, 400), rng:NextNumber(-400, 400)))
				pcall(PoseAnimatorModule.kick, defender, "Head", Vector3.new(rng:NextNumber(-500, 500), rng:NextNumber(-500, 500), 0))
			end
			local character = localPlayer and localPlayer.Character
			if character and (character == attacker or character == defender) then
				CameraFX.shake(layer.shake or 0.18)
				CameraFX.punch(at.XVector * (rng:NextNumber() < 0.5 and -1 or 1), 0.25)
			end
		end)
	end
end


------------------------------------------------------------------------
-- Rays, wisps, risers, converging energy

local function raysLayer(layer, resolveFrame)
	local origin = layer.origin and Vector3.new(layer.origin[1], layer.origin[2], layer.origin[3]) or Vector3.zero
	local list = layer.rays
	local chains = {}
	local skins = {
		{ w = 0.35, color = { 255, 255, 255 }, alpha = 1, tex = "core", brightness = 4 },
		{ w = 1.0, color = layer.tint or layer.color, alpha = 0.45, tex = "soft", brightness = 2 },
	}
	for i in ipairs(list) do
		chains[i] = { newChain(3, skins[1]), newChain(3, skins[2]) }
	end
	local start = os.clock()
	local function cleanup()
		for _, pair in ipairs(chains) do
			pair[1]:destroy()
			pair[2]:destroy()
		end
	end
	run(function()
		local age = os.clock() - start
		local frame = resolveFrame()
		if age >= layer.life or not frame then
			cleanup()
			return false
		end
		for i, ray in ipairs(list) do
			local u = math.clamp((age - ray.delay) / math.max(layer.life - ray.delay, 1e-3), 0, 1)
			local a = math.rad(ray.angle)
			local e = math.rad(ray.elevation)
			local d
			if layer.plane == "XZ" then
				d = Vector3.new(math.cos(a) * math.cos(e), math.sin(e), math.sin(a) * math.cos(e))
			else
				d = Vector3.new(math.cos(a) * math.cos(e), math.sin(a) * math.cos(e), math.sin(e))
			end
			local len = ray.length * ev(layer.length, u)
			local alpha = age < ray.delay and 0 or ev(layer.alpha, u)
			local p0 = frame:PointToWorldSpace(origin + d * ray.start)
			local p1 = frame:PointToWorldSpace(origin + d * (ray.start + len * 0.3))
			local p2 = frame:PointToWorldSpace(origin + d * (ray.start + len))
			local w = ray.width
			chains[i][1]:set({ p0, p1, p2 }, { w * 0.5, w, 0 }, { alpha, alpha, alpha * 0.6 })
			chains[i][2]:set({ p0, p1, p2 }, { w * 0.5 * 2.5, w * 2.5, 0 }, { alpha, alpha, 0 })
		end
		return true
	end, cleanup)
end

local WISP_POINTS = 6

local function wispPath(w, tau, frameBillboard)
	local p = Vector3.new(w.p[1], w.p[2], w.p[3])
	local v = Vector3.new(w.v[1], w.v[2], w.v[3])
	local side = Vector3.zAxis:Cross(v)
	side = side.Magnitude > 1e-4 and side.Unit or Vector3.xAxis
	return p + v * tau + side * (w.curl * tau * tau * 6)
end

local function wispsLayer(layer, resolveFrame, lockFrame)
	local base = resolveFrame()
	if not base then
		return
	end
	local fixed = lockFrame and base or nil
	local skins = {
		{ w = 0.3, color = layer.color, alpha = 1, tex = "core", brightness = 2.5 },
		{ w = 1.0, color = layer.tint or layer.color, alpha = 0.35, tex = "soft", brightness = 1.5 },
	}
	local items = {}
	local longest = 0
	for i, w in ipairs(layer.wisps) do
		items[i] = { w = w, chains = { newChain(WISP_POINTS, skins[1]), newChain(WISP_POINTS, skins[2]) } }
		longest = math.max(longest, w.delay + w.life)
	end
	local start = os.clock()
	local function cleanup()
		for _, item in ipairs(items) do
			item.chains[1]:destroy()
			item.chains[2]:destroy()
		end
	end
	run(function()
		local age = os.clock() - start
		local frame = fixed or resolveFrame()
		if age >= longest or not frame then
			cleanup()
			return false
		end
		frame = billboard(frame, layer.billboard)
		for _, item in ipairs(items) do
			local w = item.w
			local tau = age - w.delay
			if tau > 0 and tau < w.life then
				local u = tau / w.life
				local speed = Vector3.new(w.v[1], w.v[2], w.v[3]).Magnitude
				local span = w.length / math.max(speed, 0.1)
				local pts, ws, as = {}, {}, {}
				for k = 0, WISP_POINTS - 1 do
					local t = math.max(0, tau - span * k / (WISP_POINTS - 1))
					pts[k + 1] = frame:PointToWorldSpace(wispPath(w, t))
					local along = 1 - k / (WISP_POINTS - 1)
					ws[k + 1] = w.width * (1 - u * 0.6) * (along ^ 0.8) * math.min(1, k / 1.5 + 0.35)
					as[k + 1] = (1 - u ^ 1.5) * along
				end
				item.chains[1]:set(pts, ws, as)
				item.chains[2]:set(pts, ws, as)
			else
				item.chains[1]:set({ frame.Position }, { 0 }, { 0 })
				item.chains[2]:set({ frame.Position }, { 0 }, { 0 })
			end
		end
		return true
	end, cleanup)
end

local function risersLayer(layer, frame)
	local rng = Random.new(layer.seed or 1)
	local skins = {
		{ w = 0.35, color = layer.color, alpha = 1, tex = "core", brightness = 3 },
		{ w = 1.0, color = layer.tint or layer.color, alpha = 0.35, tex = "soft", brightness = 1.5 },
	}
	local items = {}
	local longest = 0
	for i = 1, layer.count do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(layer.radius[1], layer.radius[2])
		local item = {
			base = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r),
			height = rng:NextNumber(layer.height[1], layer.height[2]),
			speed = rng:NextNumber(layer.speed[1], layer.speed[2]),
			life = rng:NextNumber(layer.life[1], layer.life[2]),
			delay = rng:NextNumber(0, 0.08),
			chains = { newChain(3, skins[1]), newChain(3, skins[2]) },
		}
		items[i] = item
		longest = math.max(longest, item.delay + item.life)
	end
	local start = os.clock()
	local function cleanup()
		for _, item in ipairs(items) do
			item.chains[1]:destroy()
			item.chains[2]:destroy()
		end
	end
	run(function()
		local age = os.clock() - start
		if age >= longest then
			cleanup()
			return false
		end
		for _, item in ipairs(items) do
			local tau = age - item.delay
			if tau > 0 and tau < item.life then
				local u = tau / item.life
				local top = math.min(item.height + 6, item.speed * tau)
				local length = item.height * (0.35 + 0.65 * (1 - u))
				local bottom = math.max(0, top - length)
				local a = (1 - u) ^ 1.3
				local p0 = frame:PointToWorldSpace(item.base + Vector3.new(0, bottom, 0))
				local p1 = frame:PointToWorldSpace(item.base + Vector3.new(0, (bottom + top) / 2, 0))
				local p2 = frame:PointToWorldSpace(item.base + Vector3.new(0, top, 0))
				local w = layer.width
				item.chains[1]:set({ p0, p1, p2 }, { 0, w, w * 0.2 }, { a * 0.5, a, a })
				item.chains[2]:set({ p0, p1, p2 }, { 0, w * 2.5, 0 }, { a * 0.5, a, a })
			else
				item.chains[1]:set({ frame.Position }, { 0 }, { 0 })
				item.chains[2]:set({ frame.Position }, { 0 }, { 0 })
			end
		end
		return true
	end, cleanup)
end

------------------------------------------------------------------------
-- Blade geometry

local function bladeOf(model)
	local katana = model:FindFirstChild("Katana")
	local blade = katana and katana:FindFirstChild("KatanaBlade")
	if not blade or not blade:IsA("BasePart") then
		return nil
	end
	return blade
end

-- Base and tip of the blade in its own part space (longest axis; the tip
-- end is the one nearest BladeTip when it exists).
local bladeLocal = setmetatable({}, { __mode = "k" })
local function bladeEnds(blade)
	local cached = bladeLocal[blade]
	if not cached then
		local size = blade.Size
		local axis
		if size.X >= size.Y and size.X >= size.Z then
			axis = Vector3.new(size.X / 2, 0, 0)
		elseif size.Y >= size.Z then
			axis = Vector3.new(0, size.Y / 2, 0)
		else
			axis = Vector3.new(0, 0, size.Z / 2)
		end
		local tipAttachment = blade:FindFirstChild("BladeTip")
		local tip, base = axis, -axis
		if tipAttachment and tipAttachment:IsA("Attachment") then
			if (tipAttachment.Position - (-axis)).Magnitude < (tipAttachment.Position - axis).Magnitude then
				tip, base = -axis, axis
			end
			tip = tipAttachment.Position
		end
		cached = { base = base, tip = tip }
		bladeLocal[blade] = cached
	end
	return blade.CFrame:PointToWorldSpace(cached.base), blade.CFrame:PointToWorldSpace(cached.tip), cached
end

-- Trails on the blade (built once per blade): the body ribbon from base to
-- tip, and a hot edge band near the tip.
local function bladeTrails(blade)
	local existing = blade:FindFirstChild("KatanaFXBody")
	if existing then
		return existing, blade:FindFirstChild("KatanaFXEdge")
	end
	local _, _, ends = bladeEnds(blade)
	local function attachment(name, position)
		local a = Instance.new("Attachment")
		a.Name = name
		a.Position = position
		a.Parent = blade
		return a
	end
	local a0 = attachment("KatanaFXBase", ends.base)
	local a1 = attachment("KatanaFXTip", ends.tip)
	local a2 = attachment("KatanaFXEdgeStart", ends.base:Lerp(ends.tip, 0.62))
	local custom = textureFor("bladeTrail")
	local body = Instance.new("Trail")
	body.Name = "KatanaFXBody"
	body.Attachment0 = a0
	body.Attachment1 = a1
	body.FaceCamera = false
	body.LightEmission = 1
	body.LightInfluence = 0
	body.MinLength = 0.02
	body.Lifetime = 0.2
	body.TextureMode = Enum.TextureMode.Stretch
	if custom and custom ~= "" then
		-- the texture carries the white edge and lavender body itself
		body.Texture = custom
		body.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 176, 255))
		body.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 1) })
	else
		body.Color = ColorSequence.new(Color3.fromRGB(214, 196, 255), Color3.fromRGB(146, 104, 255))
		body.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(0.6, 0.75), NumberSequenceKeypoint.new(1, 1) })
	end
	body.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.35) })
	setBrightness(body, 2)
	body.Enabled = false
	body.Parent = blade
	local edge = Instance.new("Trail")
	edge.Name = "KatanaFXEdge"
	edge.Attachment0 = a2
	edge.Attachment1 = a1
	edge.FaceCamera = false
	edge.LightEmission = 1
	edge.LightInfluence = 0
	edge.MinLength = 0.02
	edge.Lifetime = 0.16
	edge.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(128, 228, 255))
	edge.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.5, 0.5), NumberSequenceKeypoint.new(1, 1) })
	edge.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.15) })
	setBrightness(edge, 3)
	edge.Enabled = false
	edge.Parent = blade
	return body, edge
end

------------------------------------------------------------------------
-- Afterimages: a lavender snapshot of the body (and blade) that fades in place

local GHOST_PARTS = { "Head", "Torso", "Right Arm", "Left Arm", "Right Leg", "Left Leg" }

local function afterimage(model, color, life, alpha)
	local ghosts = {}
	local function ghost(part)
		local g = Instance.new("Part")
		g.Anchored = true
		g.CanCollide = false
		g.CanQuery = false
		g.CanTouch = false
		g.CastShadow = false
		g.Material = Enum.Material.Neon
		g.Color = rgb(color)
		g.Size = part.Size
		g.CFrame = part.CFrame
		g.Transparency = 1 - alpha
		g.Parent = folder()
		table.insert(ghosts, g)
	end
	for _, name in ipairs(GHOST_PARTS) do
		local part = model:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			ghost(part)
		end
	end
	local blade = bladeOf(model)
	if blade then
		ghost(blade)
	end
	local start = os.clock()
	run(function()
		local u = (os.clock() - start) / life
		if u >= 1 then
			for _, g in ipairs(ghosts) do
				g:Destroy()
			end
			return false
		end
		for _, g in ipairs(ghosts) do
			g.Transparency = 1 - alpha * (1 - u) ^ 1.6
		end
		return true
	end, function()
		for _, g in ipairs(ghosts) do
			g:Destroy()
		end
	end)
end

------------------------------------------------------------------------
-- Camera cues, by who's watching

local function localRoot()
	local character = localPlayer and localPlayer.Character
	return character, character and character:FindFirstChild("HumanoidRootPart")
end

local FLASH_TINT = Color3.fromRGB(236, 228, 255)

local function cameraLayer(layer, frame, attacker, defender)
	local character, root = localRoot()
	if not character then
		return
	end
	local cue
	local falloff = 1
	if attacker == character then
		cue = layer.attacker
	elseif defender == character then
		cue = layer.victim
	elseif layer.near and root then
		cue = layer.near
		falloff = math.clamp(1 - (root.Position - frame.Position).Magnitude / (cue.radius or 50), 0, 1)
		if falloff <= 0 then
			return
		end
	end
	if not cue then
		return
	end
	if cue.shake then
		CameraFX.shake(cue.shake * falloff)
	end
	if cue.punch then
		local p = cue.punch
		CameraFX.punch(frame:VectorToWorldSpace(Vector3.new(p[1], p[2], p[3])), p[4] * falloff)
	end
	if cue.fov then
		CameraFX.fovKick(cue.fov * falloff)
	end
	if cue.roll then
		CameraFX.rollKick(cue.roll * (random:NextNumber() < 0.5 and -1 or 1))
	end
	if cue.impact then
		CameraFX.impactFrame(cue.impact * falloff)
	end
	if cue.flash then
		CameraFX.flash(cue.flash * falloff, FLASH_TINT)
	end
	if cue.blur then
		CameraFX.blur(cue.blur * falloff)
	end
end

------------------------------------------------------------------------
-- Playing a list of layers against a set of frames

-- ctx: { frames = { name = function() -> CFrame? }, attacker, defender, session }
local spawnLayer -- forward

local function playLayers(layers, ctx, clock)
	-- clock() -> seconds since the trigger (a session's clip time or real time)
	local pending = {}
	for _, layer in ipairs(layers) do
		table.insert(pending, layer)
	end
	table.sort(pending, function(a, b)
		return (a.at or 0) < (b.at or 0)
	end)
	local index = 1
	local function step()
		local now = clock()
		if now == nil then
			return false
		end
		while index <= #pending and now >= (pending[index].at or 0) do
			spawnLayer(pending[index], ctx)
			index += 1
		end
		return index <= #pending
	end
	if step() then
		run(step)
	end
end

local function resolver(ctx, name)
	local frames = ctx.frames
	-- the layer's own frame, else the context's main one (impacts have no
	-- "root": camera and sound cues sit on the cut / the crescent instead)
	return frames[name] or frames.root or frames.cut or frames.proj or frames.ground
end

spawnLayer = function(layer, ctx)
	local kind = layer.type
	local resolve = resolver(ctx, layer.frame or "root")
	if not resolve then
		return
	end
	-- frames that move (the blade, the travelling crescent) are followed
	-- by layers that need it; everything else is frozen where it spawned
	local frame = resolve()
	if not frame and kind ~= "sound" then
		return
	end
	local followed = layer.frame == "proj" and ctx.followProj
	local fixed = function()
		return frame
	end
	if kind == "stroke" then
		strokeLayer(layer, followed and resolve or fixed, layer.life)
	elseif kind == "glow" or kind == "sprite" then
		spriteLayer(layer, frame, (layer.frame == "tip") and resolve or nil)
	elseif kind == "rays" then
		raysLayer(layer, fixed)
	elseif kind == "wisps" then
		wispsLayer(layer, fixed, true)
	elseif kind == "sparks" then
		sparksLayer(layer, frame)
	elseif kind == "dust" then
		dustLayer(layer, frame)
	elseif kind == "light" then
		lightLayer(layer, fixed)
	elseif kind == "risers" then
		risersLayer(layer, frame)
	elseif kind == "burst" then
		burstLayer(layer, frame)
	elseif kind == "flurry" then
		flurryLayer(layer, frame, ctx.attacker, ctx.defender)
	elseif kind == "sound" then
		local at = frame and frame.Position or (ctx.attackerRoot and ctx.attackerRoot.Position)
		if at then
			playSound(layer.name, at, layer.volume, layer.pitch)
		end
	elseif kind == "camera" then
		cameraLayer(layer, frame, ctx.attacker, ctx.defender)
	elseif kind == "converge" and ctx.session then
		ctx.session:converge(layer)
	elseif kind == "bladewisps" and ctx.session then
		ctx.session:bladeWisps(layer)
	end
end

------------------------------------------------------------------------
-- The travelling crescent

local projectiles = {} -- [attacker model] = { list of live projectiles }

-- speed and range are the server's (Config), so the visual and the hitbox agree
local function flight()
	local S = Config.KatanaSkills and Config.KatanaSkills.KatanaCrescent
	local P = Data.Katana_Crescent.projectile
	return (S and S.speed) or P.speed, (S and S.range) or P.range
end

local function newProjectile(model, origin, direction, spec, tilt)
	local P = spec
	local self = {
		model = model,
		origin = origin,
		direction = direction,
		tilt = math.rad(tilt or 0),
		start = os.clock(),
		travelled = 0,
		state = "flying", -- flying -> hold / carry -> done
		chains = {},
	}
	local count = P.segments + 1
	for i, skin in ipairs(P.skins) do
		self.chains["skin" .. i] = newChain(count, skin)
	end
	self.lightAttachment = attachmentAt(origin)
	local light = Instance.new("PointLight")
	light.Color = rgb(P.light.color)
	light.Brightness = P.light.brightness
	light.Range = P.light.range
	light.Shadows = false
	light.Parent = self.lightAttachment
	-- smoke, embers and sparks pouring off it as it flies
	self.emitters = {}
	for _, look in ipairs(P.emitters or {}) do
		local texture = textureFor(look.sprite)
		if texture and texture ~= "" then
			local emitter = makeEmitter(look, texture)
			emitter.Parent = self.lightAttachment
			table.insert(self.emitters, emitter)
		end
	end
	self.params = groundParams()
	return self
end

-- the crescent's base frame (chord bottom on the floor), leaning by its tilt
local function projectileFrame(p)
	local position = p.origin + p.direction * p.travelled
	local up = CFrame.fromAxisAngle(p.direction, p.tilt):VectorToWorldSpace(Vector3.yAxis)
	return CFrame.fromMatrix(position, up, p.direction, up:Cross(p.direction))
end

local function destroyProjectile(p)
	if p.destroyed then
		return
	end
	p.destroyed = true
	for _, chain in pairs(p.chains) do
		chain:destroy()
	end
	p.lightAttachment:Destroy()
	local list = projectiles[p.model]
	if list then
		local i = table.find(list, p)
		if i then
			table.remove(list, i)
		end
	end
end

local function drawProjectile(p, fadeAlpha)
	local P = Data.Katana_Crescent.projectile
	local age = os.clock() - p.start
	local grow = ev(P.grow, age)
	local chord = P.chord * grow
	local sag = ev(P.sagitta, age) * grow
	-- the chord stands on the floor: its centre is half a chord up
	local base = projectileFrame(p) * CFrame.new(chord / 2, 0, 0)
	local frame = billboard(base, P.billboard)
	local pulse = 1 + P.pulse[1] * math.sin(age * P.pulse[2])
	local width = P.width * grow * pulse
	local count = P.segments + 1
	local positions, normals, ss = shapePoints({ shape = "chord", chord = chord, sagitta = sag }, 0, 0, 1, count)
	for i, skin in ipairs(P.skins) do
		local pts, ws, as = {}, {}, {}
		for k = 1, count do
			local w = width * profile(ss[k], P.taper)
			pts[k] = frame:PointToWorldSpace(positions[k] - normals[k] * (skin.inset or 0) * w)
			ws[k] = w * skin.w
			as[k] = fadeAlpha
		end
		p.chains["skin" .. i]:set(pts, ws, as)
	end
	return base
end

-- frames for a projectile where it is now (impacts, detonations, trails)
local function projectileContext(p, attacker, defender)
	local base = projectileFrame(p)
	local floor = floorBelow(base.Position + Vector3.new(0, 4, 0), 14) or (base.Position - Vector3.new(0, 0.4, 0))
	local ground = CFrame.fromMatrix(floor, p.direction, Vector3.yAxis, p.direction:Cross(Vector3.yAxis))
	local centre = base * CFrame.new(Data.Katana_Crescent.projectile.chord / 2, 0, 0)
	return {
		frames = {
			proj = function()
				return centre
			end,
			ground = function()
				return ground
			end,
			root = function()
				return centre
			end,
		},
		attacker = attacker,
		defender = defender,
	}
end
KatanaFX._projectileContext = projectileContext

local function detonate(p, layers, attacker, defender)
	p.state = "done"
	p.doneAt = os.clock()
	for _, emitter in ipairs(p.emitters) do
		emitter.Enabled = false
	end
	local ctx = projectileContext(p, attacker or p.model, defender)
	local start = os.clock()
	playLayers(layers, ctx, function()
		return os.clock() - start
	end)
end

local function updateProjectile(p, dt)
	local P = Data.Katana_Crescent.projectile
	local now = os.clock()
	local speed, range = flight()
	if p.state == "hold" and now - p.since > 0.4 then
		-- the server never confirmed a hit (dodged, or our view was off)
		detonate(p, Data.Katana_Crescent.dissolve)
	elseif p.state == "carry" and now >= p.carryUntil then
		-- driven through them: now it blows
		detonate(p, Data.Katana_Crescent.impact, p.hitBy, p.victim)
	end
	if p.state ~= "done" then
		local step = (p.state == "flying" and speed or speed * P.carry.speed) * dt
		local bottom = p.origin + p.direction * p.travelled
		-- walls end it (combatants are the server's call)
		local probe = Workspace:Raycast(bottom + Vector3.new(0, 3, 0), p.direction * (step + 1), p.params)
		if probe then
			p.travelled += math.max(0, (probe.Position - (bottom + Vector3.new(0, 3, 0))).Magnitude - 1)
			if p.state == "carry" then
				detonate(p, Data.Katana_Crescent.impact, p.hitBy, p.victim)
			else
				detonate(p, Data.Katana_Crescent.dissolve)
			end
		else
			p.travelled += step
			if p.travelled >= range and p.state == "flying" then
				p.travelled = range
				detonate(p, Data.Katana_Crescent.dissolve)
			end
		end
		-- meeting someone: slow and push into them while the server decides
		if p.state == "flying" then
			local leading = p.origin + p.direction * (p.travelled + 4.5)
			for _, model in ipairs(game:GetService("CollectionService"):GetTagged("Combatant")) do
				local other = model:FindFirstChild("HumanoidRootPart")
				local humanoid = model:FindFirstChildOfClass("Humanoid")
				if model ~= p.model and other and humanoid and humanoid.Health > 0 then
					local offset = other.Position - leading
					local along = offset:Dot(p.direction)
					local side = (offset - p.direction * along) * FLAT
					local untilTime = model:GetAttribute("IFramesUntil")
					local dodging = type(untilTime) == "number" and Workspace:GetServerTimeNow() < untilTime
					if not dodging and along <= 0.5 and along > -step - 6 and side.Magnitude < 4.5 then
						p.state = "hold"
						p.since = now
						break
					end
				end
			end
		end
	end
	local fade = 1
	if p.state == "done" then
		fade = 1 - (now - p.doneAt) / P.fade
		if fade <= 0 then
			destroyProjectile(p)
			return false
		end
	end
	local centre = drawProjectile(p, math.max(fade, 0))
	p.lightAttachment.CFrame = CFrame.lookAlong(centre.Position, p.direction)
	return true
end

local function launchProjectile(model, origin, direction, tilt)
	local P = Data.Katana_Crescent.projectile
	local p = newProjectile(model, origin, direction, P, tilt)
	projectiles[model] = projectiles[model] or {}
	table.insert(projectiles[model], p)
	local last = os.clock()
	run(function()
		local now = os.clock()
		local dt = math.min(now - last, 0.1)
		last = now
		if p.destroyed then
			return false
		end
		return updateProjectile(p, dt)
	end, function()
		destroyProjectile(p)
	end)
	return p
end

function KatanaFX._projectileEnded() end

------------------------------------------------------------------------
-- Sessions: one playing skill clip on one body

local sessions = {} -- [model] = session

local Session = {}
Session.__index = Session

function Session:bladePoints()
	local blade = self.blade
	if not blade or not blade.Parent then
		return nil
	end
	local base, tip = bladeEnds(blade)
	return base, tip
end

function Session:tipFrame()
	local base, tip = self:bladePoints()
	if not base then
		return nil
	end
	local sweep = self.sweep or self.root.CFrame.RightVector
	return frameXY(tip, sweep, tip - base)
end

function Session:converge(layer)
	local rng = Random.new(layer.seed or 1)
	local skins = {
		{ w = 0.4, color = { 255, 255, 255 }, alpha = 1, tex = "core", brightness = 2.5 },
		{ w = 1.0, color = layer.color, alpha = 0.4, tex = "soft", brightness = 1.5 },
	}
	for i = 1, layer.count do
		local delay = (i - 1) / layer.count * layer.life * 0.6
		local life = layer.life * 0.55
		local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.4, 1), rng:NextNumber(-1, 1))
		dir = dir.Magnitude > 1e-3 and dir.Unit or Vector3.yAxis
		local along = rng:NextNumber(0.35, 1)
		local chains = { newChain(3, skins[1]), newChain(3, skins[2]) }
		local start = os.clock()
		run(function()
			local tau = os.clock() - start - delay
			if tau >= life or self.ended then
				chains[1]:destroy()
				chains[2]:destroy()
				return false
			end
			local base, tip = self:bladePoints()
			if not base or tau < 0 then
				chains[1]:set({ Vector3.zero }, { 0 }, { 0 })
				chains[2]:set({ Vector3.zero }, { 0 }, { 0 })
				return true
			end
			local u = tau / life
			local target = base:Lerp(tip, along)
			local eased = 1 - (1 - u) ^ 2.2
			local head = target + dir * layer.radius * (1 - eased)
			local tailDist = layer.radius * (1 - eased) + 1.6 * (1 - u)
			local tail = target + dir * math.min(layer.radius, tailDist)
			local a = math.sin(math.pi * u)
			local w = layer.width
			chains[1]:set({ tail, (tail + head) / 2, head }, { 0, w, w * 0.4 }, { 0, a, a })
			chains[2]:set({ tail, (tail + head) / 2, head }, { 0, w * 3, w }, { 0, a, a })
			return true
		end, function()
			chains[1]:destroy()
			chains[2]:destroy()
		end)
	end
end

function Session:bladeWisps(layer)
	local rng = Random.new(layer.seed or 1)
	local base, tip = self:bladePoints()
	if not base then
		return
	end
	local frame = frameXY(base, (tip - base), Vector3.yAxis)
	local length = (tip - base).Magnitude
	local list = {}
	for _ = 1, layer.count do
		table.insert(list, {
			p = { rng:NextNumber(0.3, 1) * length, 0, 0 },
			v = { rng:NextNumber(-0.5, 0.5), rng:NextNumber(2, 4), rng:NextNumber(-0.8, 0.8) },
			curl = rng:NextNumber(-1.5, 1.5),
			length = rng:NextNumber(0.8, 1.4),
			width = rng:NextNumber(0.12, 0.22),
			life = layer.life * rng:NextNumber(0.7, 1),
			delay = rng:NextNumber(0, 0.15),
		})
	end
	wispsLayer({ wisps = list, color = { 255, 255, 255 }, tint = { 200, 176, 255 }, billboard = 0 }, function()
		return frame
	end, true)
end

function Session:cutFrame(contact)
	local snapshot = self.hitSnapshot
	local root = self.root
	local sweep, out
	if snapshot then
		sweep, out = snapshot.sweep, snapshot.blade
	else
		-- not on screen yet (an effect that beat the clip here): the authored cut
		sweep = -root.CFrame.RightVector
		out = root.CFrame.LookVector
	end
	return frameXY(contact, sweep, out)
end

function Session:frames()
	local s = self
	return {
		tip = function()
			return s:tipFrame()
		end,
		root = function()
			return s.root.Parent and s.root.CFrame or nil
		end,
		feet = function()
			if not s.root.Parent then
				return nil
			end
			local at = floorBelow(s.root.Position, 6) or (s.root.Position - Vector3.new(0, 3, 0))
			return CFrame.fromMatrix(at, flatUnit(s.root.CFrame.RightVector, Vector3.xAxis), Vector3.yAxis)
		end,
		release = function()
			local _, tip = s:bladePoints()
			local root = s.root.CFrame
			local at = tip or root:PointToWorldSpace(Vector3.new(0, 0.5, -5))
			return CFrame.fromMatrix(at, root.RightVector, Vector3.yAxis)
		end,
	}
end

function Session:update(dt)
	local track = self.track
	local model = self.model
	if not model.Parent or not self.root.Parent then
		self:finish(true)
		return false
	end
	local t = track.time or 0
	local length = self.clipLength
	if not track.IsPlaying then
		self:finish(t < length - 0.08)
		return false
	end
	self.t = t
	local spec = self.spec

	-- blade sweep direction (for tip frames and the cut)
	local base, tip = self:bladePoints()
	if tip then
		if self.lastTip and dt > 0 then
			local v = (tip - self.lastTip)
			if v.Magnitude > 0.05 then
				self.sweep = v.Unit
			end
		end
		self.lastTip = tip
	end

	-- blade energy: halo tightening, glow and light
	if base then
		local glow = ev(spec.blade.glow, t)
		local halo = ev(spec.blade.halo, t)
		local mid = base:Lerp(tip, 0.55)
		self.bladeCore:set({ base, mid, tip }, { 0.22 * glow, 0.2 * glow, 0.06 }, { glow, glow, glow * 0.8 })
		self.bladeHalo:set({ base, mid, tip }, { 0.9 * halo * glow, 1.0 * halo * glow, 0.3 * halo }, { 0.55, 0.6, 0.3 })
		self.light.Brightness = ev(spec.blade.light, t)
		self.light.Range = 9 + 3 * glow
	end

	-- trails
	local on, lifetime = false, 0.2
	for _, window in ipairs(spec.trails) do
		if t >= window[1] and t <= window[2] then
			on, lifetime = true, window[3]
		end
	end
	if self.trailBody then
		self.trailBody.Enabled = on
		self.trailEdge.Enabled = on
		self.trailBody.Lifetime = lifetime
		self.trailEdge.Lifetime = lifetime * 0.8
	end

	-- dash: afterimages and the energy wake behind the body
	local ai = spec.afterimages
	if ai and t >= ai.from and t <= ai.to and (not self.lastGhost or t - self.lastGhost >= ai.every) then
		self.lastGhost = t
		afterimage(model, ai.color, ai.life, ai.alpha)
	end
	local wake = spec.wake
	if wake then
		local now = os.clock()
		if t >= wake.from and t <= wake.to then
			table.insert(self.wakeHistory, { at = now, p = self.root.Position + Vector3.new(0, wake.height, 0) })
		end
		while #self.wakeHistory > 0 and now - self.wakeHistory[1].at > wake.history do
			table.remove(self.wakeHistory, 1)
		end
		local n = #self.wakeHistory
		if n >= 2 then
			local pts, ws, as = {}, {}, {}
			for i = 1, 8 do
				local h = self.wakeHistory[math.max(1, math.floor(1 + (n - 1) * (i - 1) / 7 + 0.5))]
				local u = (now - h.at) / wake.history
				pts[i] = h.p
				-- thickest at the body, tapering to a point behind
				ws[i] = wake.width * (1 - u) ^ 1.2
				as[i] = (1 - u)
			end
			for _, chain in ipairs(self.wakeChains) do
				chain:set(pts, ws, as)
			end
		else
			for _, chain in ipairs(self.wakeChains) do
				chain:set({ self.root.Position }, { 0 }, { 0 })
			end
		end
	end

	-- Moonfall's releases: each one throws a crescent from the floor in front
	if self.releases then
		for i, release in ipairs(self.releases) do
			local at = self.markers[release.marker]
			if at and not self.released[i] and t >= at then
				self.released[i] = true
				local root = self.root.CFrame
				local direction = flatUnit(root.LookVector)
				local from = root.Position + direction * 3
				local floor = floorBelow(from + Vector3.new(0, 2, 0), 10) or (from - Vector3.new(0, 3, 0))
				launchProjectile(self.model, floor + Vector3.new(0, Data.Katana_Crescent.projectile.height, 0), direction, release.tilt)
			end
		end
	end

	-- emitters that pour while their window is open (dash smoke, aura)
	for _, e in ipairs(self.emitters) do
		e.emitter.Enabled = t >= e.look.from and t <= e.look.to
	end

	-- the Hit marker: remember where the blade was and which way it cut
	local hitAt = self.markers.Hit
	if hitAt and not self.hitSnapshot and t >= hitAt then
		-- (without a blade part to read, fall back on the body)
		local rootCF = self.root.CFrame
		self.hitSnapshot = {
			at = os.clock(),
			tip = tip or rootCF:PointToWorldSpace(Vector3.new(0, 0, -4.5)),
			sweep = self.sweep or -rootCF.RightVector,
			blade = (tip and base) and (tip - base).Unit or rootCF.LookVector,
		}
		self:onHitMarker()
	end
	return true
end

function Session:onHitMarker()
	local name = self.clipName
	if name == "Katana_Rush" then
		-- a whiff still slashes the air (a hit replaces it within a beat)
		local session = self
		local own = localPlayer and self.model == localPlayer.Character
		task.delay(own and 0.06 or 0.2, function()
			if session.impacted or session.ended then
				return
			end
			local snapshot = session.hitSnapshot
			local contact = snapshot.tip - snapshot.blade * 1.2
			local frame = session:cutFrame(contact)
			local start = os.clock()
			playLayers(Data.Katana_Rush.whiff, {
				frames = { cut = function()
					return frame
				end },
				attacker = session.model,
			}, function()
				return os.clock() - start
			end)
		end)
	end
end

function Session:finish(interrupted)
	if self.ended then
		return
	end
	self.ended = true
	if sessions[self.model] == self then
		sessions[self.model] = nil
	end
	if self.trailBody then
		self.trailBody.Enabled = false
		self.trailEdge.Enabled = false
	end
	for _, e in ipairs(self.emitters) do
		e.emitter.Enabled = false
		Debris:AddItem(e.holder, 2)
	end
	-- blade glow and wake fade out quickly instead of popping off
	local core, halo, light = self.bladeCore, self.bladeHalo, self.light
	local wakeChains = self.wakeChains
	local session = self
	local start = os.clock()
	local fadeTime = interrupted and 0.12 or 0.25
	run(function()
		local u = (os.clock() - start) / fadeTime
		if u >= 1 then
			core:destroy()
			halo:destroy()
			for _, chain in ipairs(wakeChains) do
				chain:destroy()
			end
			light:Destroy()
			return false
		end
		local base, tip = session:bladePoints()
		if base then
			local a = 1 - u
			local mid = base:Lerp(tip, 0.55)
			core:set({ base, mid, tip }, { 0.12 * a, 0.1 * a, 0.04 }, { 0.4 * a, 0.4 * a, 0.3 * a })
			halo:set({ base, mid, tip }, { 0.6 * a, 0.7 * a, 0.2 }, { 0.3 * a, 0.3 * a, 0 })
		else
			core:set({ Vector3.zero }, { 0 }, { 0 })
			halo:set({ Vector3.zero }, { 0 }, { 0 })
		end
		for _, chain in ipairs(wakeChains) do
			chain:set({ Vector3.zero }, { 0 }, { 0 })
		end
		light.Brightness *= 0.8
		return true
	end, function()
		core:destroy()
		halo:destroy()
		for _, chain in ipairs(wakeChains) do
			chain:destroy()
		end
		light:Destroy()
	end)
end

function KatanaFX.begin(model, track, clipName)
	local spec = Data[clipName]
	local root = model:FindFirstChild("HumanoidRootPart")
	if not spec or not root then
		return nil
	end
	local old = sessions[model]
	if old then
		old:finish(true)
	end
	local AnimationData = require(Combat.AnimationData)
	local clip = AnimationData[clipName]
	local blade = bladeOf(model)
	local self = setmetatable({
		model = model,
		root = root,
		track = track,
		clipName = clipName,
		clipLength = clip and clip.length or 1,
		markers = clip and clip.markers or {},
		spec = spec,
		blade = blade,
		wakeHistory = {},
		wakeChains = {},
		t = 0,
	}, Session)
	self.bladeCore = newChain(3, { w = 1, color = { 255, 255, 255 }, alpha = 1, tex = "core", brightness = 3 })
	self.bladeHalo = newChain(3, { w = 1, color = { 200, 176, 255 }, alpha = 1, tex = "soft", brightness = 1.6 })
	local lightHolder = blade or root
	self.light = Instance.new("PointLight")
	self.light.Name = "KatanaFXLight"
	self.light.Color = Color3.fromRGB(200, 176, 255)
	self.light.Brightness = 0
	self.light.Range = 10
	self.light.Shadows = false
	self.light.Parent = lightHolder
	if blade then
		self.trailBody, self.trailEdge = bladeTrails(blade)
	end
	if spec.wake then
		for _, skin in ipairs(spec.wake.skins) do
			table.insert(self.wakeChains, newChain(8, skin))
		end
	end
	-- pouring emitters, on the body or the blade
	self.emitters = {}
	for _, look in ipairs(spec.emitters or {}) do
		local texture = textureFor(look.sprite)
		if texture and texture ~= "" then
			local holder = Instance.new("Attachment")
			holder.Name = "KatanaFXEmitter"
			local parent = root
			if look.attach == "tip" and blade then
				local _, _, ends = bladeEnds(blade)
				holder.Position = ends.base:Lerp(ends.tip, 0.6)
				parent = blade
			elseif look.offset then
				holder.Position = Vector3.new(look.offset[1], look.offset[2], look.offset[3])
			end
			if look.dir then
				local d = Vector3.new(look.dir[1], look.dir[2], look.dir[3]).Unit
				local right = math.abs(d.Y) < 0.95 and d:Cross(Vector3.yAxis).Unit or d:Cross(Vector3.xAxis).Unit
				holder.CFrame = CFrame.fromMatrix(holder.Position, right, d)
			end
			holder.Parent = parent
			local emitter = makeEmitter(look, texture)
			emitter.Enabled = false
			emitter.Parent = holder
			table.insert(self.emitters, { look = look, emitter = emitter, holder = holder })
		end
	end
	if clipName == "Katana_Crescent" then
		self.releases = (Config.Attacks.KatanaCrescent and Config.Attacks.KatanaCrescent.releases) or { { marker = "Hit", tilt = 0 } }
		self.released = {}
	end
	sessions[model] = self

	-- the cast timeline runs on the clip's own clock
	local ctx = { frames = self:frames(), attacker = model, session = self, attackerRoot = root }
	playLayers(spec.cast, ctx, function()
		if self.ended then
			return nil
		end
		return self.t
	end)

	local last = os.clock()
	run(function()
		local now = os.clock()
		local dt = now - last
		last = now
		if self.ended then
			return false
		end
		return self:update(dt)
	end, function()
		self:finish(true)
	end)
	return self
end

function KatanaFX.cancel(model)
	local session = sessions[model]
	if session then
		session:finish(true)
	end
end

------------------------------------------------------------------------
-- Impacts (from CombatClient's effect handling)

local SKILLS = { KatanaRush = "Katana_Rush", KatanaCrescent = "Katana_Crescent" }

function KatanaFX.handles(kind, info)
	return SKILLS[info] ~= nil
end

local function nearestProjectile(attacker, position)
	local list = projectiles[attacker]
	local best, bestDistance
	if list then
		for _, p in ipairs(list) do
			if p.state ~= "done" then
				local at = p.origin + p.direction * p.travelled
				local d = ((at - position) * FLAT).Magnitude
				if not bestDistance or d < bestDistance then
					best, bestDistance = p, d
				end
			end
		end
	end
	return best
end

-- Plays the skill's side of an effect event. Returns the camera amount for
-- the generic hit feedback (shake strength), like Effects.play.
function KatanaFX.impact(kind, position, attacker, defender, info)
	local clipName = SKILLS[info]
	local spec = clipName and Data[clipName]
	if not spec then
		return 0
	end
	local clean = kind == "Hit" or kind == "HeavyHit"
	if clipName == "Katana_Rush" then
		local session = typeof(attacker) == "Instance" and sessions[attacker]
		if session then
			session.impacted = true
		end
		-- the dash ends behind them: the slashes erupt on the victim
		local victimRoot = typeof(defender) == "Instance" and defender:FindFirstChild("HumanoidRootPart")
		if victimRoot then
			position = victimRoot.Position + Vector3.new(0, 0.5, 0)
		end
		local frame
		if session then
			frame = session:cutFrame(position)
		else
			local root = typeof(attacker) == "Instance" and attacker:FindFirstChild("HumanoidRootPart")
			local look = root and root.CFrame or CFrame.lookAlong(position, Vector3.new(0, 0, -1))
			frame = frameXY(position, -look.RightVector, look.LookVector)
		end
		local floor = floorBelow(position, 10) or (position - Vector3.new(0, 3.5, 0))
		local ground = CFrame.fromMatrix(floor, flatUnit(frame.XVector), Vector3.yAxis)
		local layers = clean and spec.impact or spec.whiff
		local ctx = {
			frames = {
				cut = function()
					return frame
				end,
				ground = function()
					return ground
				end,
			},
			attacker = attacker,
			defender = defender,
		}
		local start = os.clock()
		playLayers(layers, ctx, function()
			return os.clock() - start
		end)
		return clean and 0.5 or 0.2
	end

	-- Moonfall Crescent: the travelling blade drives through them, then blows
	local p = typeof(attacker) == "Instance" and nearestProjectile(attacker, position)
	if kind == "Dodge" then
		if p and p.state == "hold" then
			p.state = "flying" -- it went straight through them
		end
		return 0
	end
	if p then
		local along = (position - p.origin):Dot(p.direction)
		local _, range = flight()
		p.travelled = math.clamp(math.max(p.travelled, along - 4), 0, range)
		if clean then
			p.state = "carry"
			p.carryUntil = os.clock() + spec.projectile.carry.time
			p.hitBy, p.victim = attacker, defender
		else
			detonate(p, spec.dissolve, attacker, defender)
		end
		return clean and 0.6 or 0.25
	end
	-- no local projectile (late joiner): the explosion where it struck
	local root = typeof(attacker) == "Instance" and attacker:FindFirstChild("HumanoidRootPart")
	local direction = root and flatUnit(position - root.Position, root.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local floor = floorBelow(position, 10) or (position - Vector3.new(0, 3, 0))
	local fake = { origin = floor + Vector3.new(0, 0.4, 0), direction = direction, travelled = 0, tilt = 0 }
	local ctx = projectileContext(fake, attacker, defender)
	local start = os.clock()
	playLayers(clean and spec.impact or spec.dissolve, ctx, function()
		return os.clock() - start
	end)
	return clean and 0.6 or 0.25
end

------------------------------------------------------------------------
-- One render-step loop for everything live (after the camera moves, so
-- billboards and screen angles use this frame's view)

RunService:BindToRenderStep("KatanaFX", Enum.RenderPriority.Camera.Value + 3, function()
	local i = 1
	while i <= #live do
		local entry = live[i]
		local ok, keep = pcall(entry.step)
		if ok and keep then
			i += 1
		else
			table.remove(live, i)
			if not ok then
				warn("KatanaFX:", keep)
				if entry.cleanup then
					pcall(entry.cleanup)
				end
			end
		end
	end
end)

return KatanaFX
