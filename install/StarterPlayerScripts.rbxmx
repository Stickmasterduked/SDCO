<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="LocalScript" referent="RBX1"><Properties>
<string name="Name">ClientMain</string>
<ProtectedString name="Source"><![CDATA[--[[
	ClientMain  (LocalScript in StarterPlayerScripts)

	The "boss" of the player's screen. It:
	  1. builds the UI using the modules in the UI folder
	  2. sends the player's clicks to the server (FireServer)
	  3. listens for the server's updates and passes them to the UI (OnClientEvent)

	It does NOT decide coins or damage; the server does that.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes") -- made by GameServer. WaitForChild = wait until it exists

-- The UI modules (they live in the "UI" folder next to this script)
local UI = script.Parent:WaitForChild("UI")
local Theme = require(UI.Theme)
local Effects = require(UI.Effects)
local HUD = require(UI.HUD)
local Panels = require(UI.Panels)

local C = Theme.Colors

---------------------------------------------------------------------------
-- 1. BUILD THE SCREEN
---------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "GameUI"
gui.ResetOnSpawn = false   -- keep the UI if the character respawns
gui.IgnoreGuiInset = true  -- cover the WHOLE screen
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

Effects.Init(gui)
local buttons = HUD.Build(gui) -- gives back { Attack, Shop, Eggs, Story }

local isHatching = false -- true while the egg animation is playing

-- "actions" = what the windows' buttons should do. Panels calls these.
local actions = {}

function actions.BuyUpgrade(upgradeId)
	Remotes.BuyUpgrade:FireServer(upgradeId) -- ask the server; it checks the price and answers with DataUpdated
end

function actions.HatchEgg(eggId)
	if isHatching then return end -- wait for the current egg to finish
	Remotes.HatchEgg:FireServer(eggId)
end

function actions.BuyPass(passId)
	if passId == 0 then
		Effects.Toast("Set this gamepass's PassId in GameConfig!", C.Red)
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, passId) -- opens Roblox's buy window
end

Panels.Build(gui, actions)

---------------------------------------------------------------------------
-- 2. BUTTONS -> SERVER
-- .Activated fires when the button is clicked OR tapped (works on phones too)
---------------------------------------------------------------------------
buttons.Attack.Activated:Connect(function()
	HUD.HeroAttack()             -- animate right away so it feels instant...
	Remotes.Attack:FireServer()  -- ...while the server does the real damage
end)

buttons.Shop.Activated:Connect(function() Panels.Open("Shop") end)
buttons.Eggs.Activated:Connect(function() Panels.Open("Eggs") end)
buttons.Story.Activated:Connect(function() Panels.Open("Story") end)

---------------------------------------------------------------------------
-- 3. SERVER -> SCREEN
-- Each OnClientEvent function receives exactly what the server put in FireClient(player, ...)
---------------------------------------------------------------------------
Remotes.DataUpdated.OnClientEvent:Connect(function(data)
	HUD.UpdateData(data)
	Panels.UpdateData(data)
end)

Remotes.EnemyUpdated.OnClientEvent:Connect(HUD.SetEnemy)       -- (info)
Remotes.EnemyHit.OnClientEvent:Connect(HUD.EnemyHit)           -- (info)
Remotes.EnemyDefeated.OnClientEvent:Connect(HUD.EnemyDefeated) -- (rewards)

Remotes.Hatched.OnClientEvent:Connect(function(characterId)
	isHatching = true
	Panels.Close()                    -- hide the egg window during the show
	Effects.PlayHatch(characterId)    -- this waits until the animation is done
	isHatching = false
end)

-- kind = "Good", "Bad" or "Level" (picks the color)
local NOTIFY_COLORS = { Good = C.Green, Bad = C.Red, Level = C.Gold }
Remotes.Notify.OnClientEvent:Connect(function(message, kind)
	Effects.Toast(message, NOTIFY_COLORS[kind])
end)

---------------------------------------------------------------------------
-- 4. TELL THE SERVER WE'RE READY
-- Everything above is hooked up, so now ask for our data + enemy.
---------------------------------------------------------------------------
Remotes.Ready:FireServer()
]]></ProtectedString>
</Properties>

</Item>
<Item class="Folder" referent="RBX2"><Properties>
<string name="Name">UI</string>
</Properties>
<Item class="ModuleScript" referent="RBX3"><Properties>
<string name="Name">Effects</string>
<ProtectedString name="Source"><![CDATA[--[[
	Effects  (ModuleScript in StarterPlayerScripts > UI)

	The "juice": damage numbers, shakes, flashes, messages and the egg hatch scene.
	Call Effects.Init(gui) once before using anything else.
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Theme = require(script.Parent.Theme)
local UIKit = require(script.Parent.UIKit)

local Effects = {}
local C = Theme.Colors
local gui = nil -- the ScreenGui, set in Init
local toastLabel = nil

function Effects.Init(screenGui)
	gui = screenGui

	-- The message ("toast") that drops in from the top of the screen
	toastLabel = UIKit.Label(gui, "", UDim2.new(0.5, 0, 0.055, 0), UDim2.new(0.5, 0, -0.1, 0))
	toastLabel.ZIndex = 50
end

-- Toast(text, color): show a short message for about 2 seconds
function Effects.Toast(text, color)
	toastLabel.Text = text
	toastLabel.TextColor3 = color or C.Text
	toastLabel.Position = UDim2.new(0.5, 0, -0.1, 0) -- start above the screen
	UIKit.Tween(toastLabel, 0.35, { Position = UDim2.new(0.5, 0, 0.27, 0) }, Enum.EasingStyle.Back)
	UIKit.Pop(toastLabel, 1.3)
	task.delay(1.8, function() -- task.delay(seconds, function) = run this later, without pausing now
		if toastLabel.Text == text then -- only hide it if no newer message replaced it
			UIKit.Tween(toastLabel, 0.3, { Position = UDim2.new(0.5, 0, -0.1, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		end
	end)
end

-- FloatText(parent, text, color, big): a number that pops up, drifts upward and fades away
function Effects.FloatText(parent, text, color, big)
	local x = 0.3 + math.random() * 0.4 -- random spot between 30% and 70% across
	local height = big and 0.16 or 0.11
	local label = UIKit.Label(parent, text, UDim2.new(0.7, 0, height, 0), UDim2.new(x, 0, 0.45, 0), color)
	label.ZIndex = 10
	label.Rotation = math.random(-12, 12)
	UIKit.Pop(label, 1.7)

	local goal = UDim2.new(x, 0, 0.15, 0) -- float up
	UIKit.Tween(label, 0.8, { Position = goal, TextTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	UIKit.Tween(label:FindFirstChildOfClass("UIStroke"), 0.8, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.8, function()
		label:Destroy() -- clean up, or thousands of invisible labels would pile up
	end)
end

-- Shake(object, strength): wiggle left and right quickly
function Effects.Shake(object, strength)
	strength = strength or 5
	task.spawn(function() -- run on the side, so the code that called Shake doesn't wait
		for i = 1, 4 do
			object.Rotation = (i % 2 == 0) and strength or -strength -- even = right, odd = left
			task.wait(0.03)
		end
		object.Rotation = 0
	end)
end

-- Flash(frame): flash a frame white for a moment (when something gets hit)
function Effects.Flash(frame)
	frame.BackgroundTransparency = 0.25
	UIKit.Tween(frame, 0.25, { BackgroundTransparency = 1 })
end

--[[
	PlayHatch(characterId)
	The big egg scene: screen darkens, egg wobbles faster and faster, white flash,
	then the character card bursts out with spinning rays behind it.
	This function WAITS until the scene is over (about 4 seconds).
]]
function Effects.PlayHatch(characterId)
	local character = nil
	for _, item in ipairs(GameConfig.Characters) do
		if item.Id == characterId then
			character = item
		end
	end
	if not character then return end
	local rarityColor = GameConfig.RarityColors[character.Rarity]

	-- dark cover over the whole screen
	local overlay = UIKit.Create("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = C.Outline,
		BackgroundTransparency = 1,
		ZIndex = 60,
	}, gui)
	UIKit.Tween(overlay, 0.3, { BackgroundTransparency = 0.25 })

	-- the egg (a tall rounded box)
	local egg = UIKit.Create("Frame", {
		Size = UDim2.new(0.2, 0, 0.27, 0),
		SizeConstraint = Enum.SizeConstraint.RelativeYY, -- size is based on screen HEIGHT, so it stays egg-shaped
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 61,
	}, overlay)
	UIKit.Corner(egg, 999) -- a huge radius = fully rounded
	UIKit.Outline(egg, 5)
	UIKit.Gradient(egg, Color3.fromRGB(255, 250, 235), C.Gold)
	UIKit.Pop(egg, 0.2) -- grow in from tiny

	-- wobble, faster each time
	for i = 1, 10 do
		local speed = 0.17 - i * 0.012
		UIKit.Tween(egg, speed, { Rotation = (i % 2 == 0) and 14 or -14 })
		task.wait(speed)
	end

	-- WHITE FLASH
	local flash = UIKit.Create("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 70,
	}, overlay)
	UIKit.Tween(flash, 0.6, { BackgroundTransparency = 1 })
	egg:Destroy()

	-- spinning rays behind the card
	local rays = UIKit.Create("Frame", {
		Size = UDim2.new(0.8, 0, 0.8, 0),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 61,
	}, overlay)
	for i = 1, 6 do
		UIKit.Create("Frame", {
			Size = UDim2.new(0.1, 0, 1, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = i * 30, -- 6 rays, 30 degrees apart (each ray pokes out both sides = 12 points)
			BackgroundColor3 = rarityColor,
			BackgroundTransparency = 0.6,
			ZIndex = 61,
		}, rays)
	end
	local spinForever = TweenInfo.new(5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1) -- -1 = repeat forever
	TweenService:Create(rays, spinForever, { Rotation = 360 }):Play()

	-- the character card
	local card = UIKit.Panel(overlay, UDim2.new(0.26, 0, 0.38, 0), UDim2.new(0.5, 0, 0.5, 0), C.Panel)
	card.SizeConstraint = Enum.SizeConstraint.RelativeYY
	card.ZIndex = 62
	card:FindFirstChildOfClass("UIStroke").Color = rarityColor -- outline in the rarity color
	card:FindFirstChildOfClass("UIStroke").Thickness = 5

	local rarityLabel = UIKit.Label(card, string.upper(character.Rarity), UDim2.new(0.8, 0, 0.11, 0), UDim2.new(0.5, 0, 0.1, 0), rarityColor)
	rarityLabel.ZIndex = 63

	local picture = UIKit.Create("ImageLabel", { -- BLANK picture. Put "rbxassetid://123" in Image later!
		Image = "",
		Size = UDim2.new(0.75, 0, 0.52, 0),
		Position = UDim2.new(0.5, 0, 0.45, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.Slot,
		ZIndex = 63,
	}, card)
	UIKit.Corner(picture)

	local nameLabel = UIKit.Label(card, character.Name, UDim2.new(0.9, 0, 0.12, 0), UDim2.new(0.5, 0, 0.79, 0))
	nameLabel.ZIndex = 63
	local powerLabel = UIKit.Label(card, "+" .. character.Power .. " POWER", UDim2.new(0.6, 0, 0.08, 0), UDim2.new(0.5, 0, 0.9, 0), C.Gold, Theme.TextFont)
	powerLabel.ZIndex = 63

	UIKit.Pop(card, 0.1) -- burst out
	task.wait(2.4) -- let them look at it

	UIKit.Tween(UIKit.GetScale(card), 0.25, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	UIKit.Tween(overlay, 0.3, { BackgroundTransparency = 1 })
	rays.Visible = false
	task.wait(0.3)
	overlay:Destroy() -- removes everything inside it too
end

return Effects
]]></ProtectedString>
</Properties>

</Item>
<Item class="ModuleScript" referent="RBX4"><Properties>
<string name="Name">HUD</string>
<ProtectedString name="Source"><![CDATA[--[[
	HUD  (ModuleScript in StarterPlayerScripts > UI)

	The main game screen (HUD = "heads-up display"):
	  top    : coins, gems, level + XP bar, stage banner
	  left   : menu buttons + YOUR character card
	  right  : the ENEMY card
	  middle : VS + the big ATTACK button

	Functions other scripts use:
	  HUD.Build(gui)            make everything (call once)
	  HUD.UpdateData(data)      refresh coins/gems/level/stats
	  HUD.SetEnemy(info)        show a new enemy
	  HUD.EnemyHit(info)        enemy took damage
	  HUD.EnemyDefeated(info)   enemy died
	  HUD.HeroAttack()          hero lunge animation
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Theme = require(script.Parent.Theme)
local UIKit = require(script.Parent.UIKit)
local Effects = require(script.Parent.Effects)

local HUD = {}
local C = Theme.Colors

-- Things we need to change later get saved in these variables during Build()
local coinsText, gemsText, levelText, xpBar
local stageTitle, stageSubtitle, stageBanner
local hero, enemy
local teamText

local HERO_X = 0.3   -- where the hero card sits (30% across the screen)
local ENEMY_X = 0.72 -- where the enemy card sits

---------------------------------------------------------------------------
-- small builders used only in this file
---------------------------------------------------------------------------

-- makeCurrency(parent, iconText, iconColor, order): a stat pill like [$] 1.2K
local function makeCurrency(parent, iconText, iconColor, order)
	local pill = UIKit.Panel(parent, UDim2.new(0.3, 0, 1, 0), UDim2.new(0, 0, 0, 0))
	pill.LayoutOrder = order -- UIListLayout puts lower numbers first
	pill.AnchorPoint = Vector2.new(0, 0) -- the list layout places it, so measure from the top-left
	pill:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(1, 0) -- fully rounded ends = pill shape

	local icon = UIKit.Create("TextLabel", {
		Size = UDim2.new(1.15, 0, 1.15, 0),
		SizeConstraint = Enum.SizeConstraint.RelativeYY, -- a perfect circle based on the pill's height
		Position = UDim2.new(0, -6, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = iconColor,
		Text = iconText,
		Font = Theme.TitleFont,
		TextScaled = true,
		TextColor3 = C.Text,
	}, pill)
	UIKit.Corner(icon, 999)
	UIKit.Outline(icon)
	UIKit.TextOutline(icon)
	UIKit.Create("UIPadding", { PaddingTop = UDim.new(0.2, 0), PaddingBottom = UDim.new(0.2, 0) }, icon)

	return UIKit.Label(pill, "0", UDim2.new(0.6, 0, 0.62, 0), UDim2.new(0.6, 0, 0.5, 0))
end

-- makeFighterCard(x, title): the big card for the hero or the enemy
local function makeFighterCard(parent, x, title)
	local card = UIKit.Panel(parent, UDim2.new(0.22, 0, 0.5, 0), UDim2.new(x, 0, 0.55, 0))
	UIKit.Create("UIAspectRatioConstraint", { AspectRatio = 0.78 }, card) -- keep the same shape on every screen

	local nameLabel = UIKit.Label(card, title, UDim2.new(0.9, 0, 0.1, 0), UDim2.new(0.5, 0, 0.09, 0))

	-- the picture slot. BLANK for now: set Image = "rbxassetid://YOUR_ID" later
	local picture = UIKit.Create("ImageLabel", {
		Image = "",
		Size = UDim2.new(0.84, 0, 0.62, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.Slot,
		ScaleType = Enum.ScaleType.Fit,
	}, card)
	UIKit.Corner(picture)
	UIKit.Outline(picture, 2)

	local flash = UIKit.Create("Frame", { -- white overlay we flash when hit
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
	}, picture)
	UIKit.Corner(flash)

	-- idle "breathing": gently float up and down forever
	local bob = TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true) -- -1 = forever, true = go back and forth
	TweenService:Create(picture, bob, { Position = UDim2.new(0.5, 0, 0.47, 0) }):Play()

	return { Frame = card, Name = nameLabel, Picture = picture, Flash = flash }
end

---------------------------------------------------------------------------
-- BUILD
---------------------------------------------------------------------------
function HUD.Build(gui)
	-- BACKGROUND: dark blue gradient
	local background = UIKit.Create("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 0,
	}, gui)
	UIKit.Gradient(background, C.BackgroundTop, C.BackgroundBottom)

	-- faint dots slowly rising (makes the background feel alive)
	for _ = 1, 16 do
		local size = math.random(12, 50)
		local dot = UIKit.Create("Frame", {
			Size = UDim2.new(0, size, 0, size),
			Position = UDim2.new(math.random(), 0, 1.1, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.93,
		}, background)
		UIKit.Corner(dot, 999)
		local rise = TweenInfo.new(math.random(10, 20), Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1)
		task.delay(math.random() * 10, function() -- start at random times so they spread out
			TweenService:Create(dot, rise, { Position = UDim2.new(dot.Position.X.Scale, 0, -0.1, 0) }):Play()
		end)
	end

	-- TOP BAR: coins, gems, level (side by side)
	local topBar = UIKit.Create("Frame", {
		Size = UDim2.new(0.5, 0, 0.065, 0),
		Position = UDim2.new(0.5, 0, 0.03, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
	}, gui)
	UIKit.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0.04, 0),
	}, topBar)
	coinsText = makeCurrency(topBar, "$", C.Gold, 1)
	gemsText = makeCurrency(topBar, "G", C.Cyan, 2)
	levelText = makeCurrency(topBar, "LV", C.PanelLight, 3)

	xpBar = UIKit.Bar(gui, UDim2.new(0.3, 0, 0.028, 0), UDim2.new(0.5, 0, 0.125, 0), C.Gold)

	-- STAGE BANNER
	stageBanner = UIKit.Panel(gui, UDim2.new(0.3, 0, 0.085, 0), UDim2.new(0.5, 0, 0.2, 0))
	stageTitle = UIKit.Label(stageBanner, "STAGE 1", UDim2.new(0.9, 0, 0.5, 0), UDim2.new(0.5, 0, 0.36, 0), C.Gold)
	stageSubtitle = UIKit.Label(stageBanner, "", UDim2.new(0.9, 0, 0.3, 0), UDim2.new(0.5, 0, 0.74, 0), C.TextDim, Theme.TextFont)

	-- FIGHTER CARDS
	hero = makeFighterCard(gui, HERO_X, Players.LocalPlayer.DisplayName)
	hero.Stats = UIKit.Label(hero.Frame, "", UDim2.new(0.9, 0, 0.08, 0), UDim2.new(0.5, 0, 0.9, 0), C.Gold, Theme.TextFont)

	enemy = makeFighterCard(gui, ENEMY_X, "???")
	enemy.Bar = UIKit.Bar(enemy.Frame, UDim2.new(0.84, 0, 0.08, 0), UDim2.new(0.5, 0, 0.9, 0), C.Red)
	enemy.BossTag = UIKit.Label(enemy.Frame, "BOSS", UDim2.new(0.5, 0, 0.1, 0), UDim2.new(0.5, 0, -0.06, 0), C.Gold)
	enemy.BossTag.Visible = false

	-- VS (pulses forever)
	local vs = UIKit.Label(gui, "VS", UDim2.new(0.1, 0, 0.1, 0), UDim2.new(0.51, 0, 0.5, 0), C.Gold)
	vs.Rotation = -8
	local pulse = TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	TweenService:Create(UIKit.GetScale(vs), pulse, { Scale = 1.15 }):Play()

	teamText = UIKit.Label(gui, "", UDim2.new(0.2, 0, 0.03, 0), UDim2.new(0.51, 0, 0.6, 0), C.TextDim, Theme.TextFont)

	-- ATTACK BUTTON (the only big gold button = the main thing to press)
	local attack, attackHolder = UIKit.Button(gui, "ATTACK!", C.Gold, UDim2.new(0.2, 0, 0.12, 0), UDim2.new(0.51, 0, 0.88, 0))
	UIKit.Create("UIAspectRatioConstraint", { AspectRatio = 3 }, attackHolder)
	local breathe = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	TweenService:Create(attackHolder, breathe, { Rotation = 2 }):Play() -- gentle tilt so it draws the eye

	-- MENU BUTTONS on the left edge
	local menu = {}
	local menuNames = { "SHOP", "EGGS", "STORY" }
	for index, name in ipairs(menuNames) do
		local y = 0.4 + (index - 1) * 0.13 -- stack them downward: 0.40, 0.53, 0.66
		local button, holder = UIKit.Button(gui, name, C.PanelLight, UDim2.new(0.1, 0, 0.1, 0), UDim2.new(0.08, 0, y, 0))
		UIKit.Create("UIAspectRatioConstraint", { AspectRatio = 1.6 }, holder)
		menu[name] = button
	end

	-- give the buttons back so ClientMain can hook them up
	return {
		Attack = attack,
		Shop = menu.SHOP,
		Eggs = menu.EGGS,
		Story = menu.STORY,
	}
end

---------------------------------------------------------------------------
-- UPDATES
---------------------------------------------------------------------------

-- UpdateData(data): refresh every number that comes from the player's data
function HUD.UpdateData(data)
	local oldCoins = coinsText.Text
	coinsText.Text = Formulas.FormatNumber(data.Coins)
	gemsText.Text = Formulas.FormatNumber(data.Gems)
	if coinsText.Text ~= oldCoins then
		UIKit.Pop(coinsText.Parent, 1.12) -- boing the pill when the number changes
	end

	local oldLevel = levelText.Text
	levelText.Text = tostring(data.Level)
	if oldLevel ~= "0" and oldLevel ~= levelText.Text then
		UIKit.Pop(levelText.Parent, 1.3)
	end

	local needed = Formulas.XPNeeded(data.Level)
	UIKit.SetBar(xpBar, data.XP / needed, "XP " .. data.XP .. " / " .. needed)

	hero.Stats.Text = "DMG " .. Formulas.FormatNumber(Formulas.ClickDamage(data))
		.. "   AUTO " .. Formulas.FormatNumber(Formulas.AutoDamage(data)) .. "/s"
	teamText.Text = "TEAM: " .. #data.Team .. "  |  POWER " .. Formulas.FormatNumber(Formulas.TeamPower(data))
end

-- SetEnemy(info): a new enemy arrives (info comes from the server)
function HUD.SetEnemy(info)
	enemy.Name.Text = info.Name
	enemy.BossTag.Visible = info.IsBoss
	enemy.Frame:FindFirstChildOfClass("UIStroke").Color = info.IsBoss and C.Gold or C.Outline -- gold outline for bosses
	UIKit.SetBar(enemy.Bar, info.Health / info.MaxHealth, Formulas.FormatNumber(info.Health) .. " / " .. Formulas.FormatNumber(info.MaxHealth))

	local stageInChapter = (info.Stage - 1) % GameConfig.StagesPerChapter + 1
	stageTitle.Text = info.IsBoss and "BOSS FIGHT!" or ("STAGE " .. stageInChapter .. " / " .. GameConfig.StagesPerChapter)
	stageTitle.TextColor3 = info.IsBoss and C.Red or C.Gold
	stageSubtitle.Text = "CHAPTER " .. info.ChapterNumber .. "  -  " .. string.upper(info.ChapterName)
	UIKit.Pop(stageBanner, 1.15)

	-- drop-in animation: start tiny and tilted, spring to full size
	local scale = UIKit.GetScale(enemy.Frame)
	scale.Scale = 0
	enemy.Frame.Rotation = 15
	UIKit.Tween(scale, 0.45, { Scale = info.IsBoss and 1.08 or 1 }, Enum.EasingStyle.Back)
	UIKit.Tween(enemy.Frame, 0.45, { Rotation = 0 }, Enum.EasingStyle.Back)
end

-- EnemyHit(info): show damage. info = { Damage, Health, MaxHealth, IsAuto }
function HUD.EnemyHit(info)
	UIKit.SetBar(enemy.Bar, info.Health / info.MaxHealth, Formulas.FormatNumber(info.Health) .. " / " .. Formulas.FormatNumber(info.MaxHealth))
	Effects.FloatText(enemy.Frame, "-" .. Formulas.FormatNumber(info.Damage), info.IsAuto and C.TextDim or C.Text)
	Effects.Flash(enemy.Flash)
	Effects.Shake(enemy.Frame, info.IsAuto and 3 or 6)
	if info.IsAuto then
		HUD.HeroAttack() -- show the hero swinging on auto hits too
	end
end

-- EnemyDefeated(info): rewards popup + the enemy spins away
function HUD.EnemyDefeated(info)
	Effects.FloatText(enemy.Frame, "+" .. Formulas.FormatNumber(info.Coins) .. " COINS", C.Gold, true)
	if info.Gems > 0 then
		Effects.FloatText(enemy.Frame, "+" .. info.Gems .. " GEMS", C.Cyan, true)
	end
	if info.WasBoss then
		Effects.Toast("BOSS DEFEATED!", C.Gold)
	end
	UIKit.Tween(UIKit.GetScale(enemy.Frame), 0.35, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	UIKit.Tween(enemy.Frame, 0.35, { Rotation = -30 })
end

-- HeroAttack(): the hero card jumps toward the enemy and bounces back
function HUD.HeroAttack()
	local frame = hero.Frame
	UIKit.Tween(frame, 0.07, { Position = UDim2.new(HERO_X + 0.04, 0, 0.55, 0), Rotation = 5 })
	task.delay(0.08, function()
		UIKit.Tween(frame, 0.3, { Position = UDim2.new(HERO_X, 0, 0.55, 0), Rotation = 0 }, Enum.EasingStyle.Back)
	end)
end

return HUD
]]></ProtectedString>
</Properties>

</Item>
<Item class="ModuleScript" referent="RBX5"><Properties>
<string name="Name">Panels</string>
<ProtectedString name="Source"><![CDATA[--[[
	Panels  (ModuleScript in StarterPlayerScripts > UI)

	The pop-up windows: SHOP, EGGS and STORY.
	This file only DRAWS them. When a button is pressed, it calls one of
	the "actions" that ClientMain hands in, and ClientMain talks to the server.

	Functions:
	  Panels.Build(gui, actions)   make all windows (call once)
	  Panels.Open(name)            open "Shop", "Eggs" or "Story"
	  Panels.UpdateData(data)      refresh prices, team and story progress
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Theme = require(script.Parent.Theme)
local UIKit = require(script.Parent.UIKit)

local Panels = {}
local C = Theme.Colors

local windows = {}       -- windows.Shop, windows.Eggs, windows.Story
local openWindow = nil   -- the window that's open right now (nil = none)
local upgradeRows = {}   -- so we can update prices later
local passRows = {}
local chapterRows = {}
local teamGrid = nil

---------------------------------------------------------------------------
-- builders
---------------------------------------------------------------------------

-- makeWindow(title): a centered window with a title, close button and a scrolling list
local function makeWindow(gui, title)
	local window = UIKit.Panel(gui, UDim2.new(0.5, 0, 0.66, 0), UDim2.new(0.5, 0, 0.52, 0))
	window.Visible = false
	window.ZIndex = 20 -- above the HUD
	UIKit.Create("UIAspectRatioConstraint", { AspectRatio = 1.3 }, window)
	window:FindFirstChildOfClass("UIStroke").Thickness = 5

	UIKit.Label(window, title, UDim2.new(0.6, 0, 0.1, 0), UDim2.new(0.5, 0, 0.08, 0), C.Gold)

	local close, closeHolder = UIKit.Button(window, "X", C.Red, UDim2.new(0.11, 0, 0.11, 0), UDim2.new(0.97, 0, 0.03, 0))
	closeHolder.SizeConstraint = Enum.SizeConstraint.RelativeYY -- keep it square
	close.Activated:Connect(function()
		Panels.Close()
	end)

	local list = UIKit.Create("ScrollingFrame", {
		Size = UDim2.new(0.94, 0, 0.8, 0),
		Position = UDim2.new(0.5, 0, 0.57, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.PanelLight,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, -- the scroll area grows as we add rows
	}, window)
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }, list)
	UIKit.Create("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, list)

	return window, list
end

-- makeHeader(list, text, order): a small section title inside a list
local function makeHeader(list, text, order)
	local header = UIKit.Label(list, text, UDim2.new(0.95, 0, 0, 32), UDim2.new(0, 0, 0, 0), C.TextDim)
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.AnchorPoint = Vector2.new(0, 0) -- the list layout places it, so measure from the top-left
	header.LayoutOrder = order
	return header
end

--[[
	makeRow(list, title, description, buttonText, buttonColor, order)
	One row: [picture] Title / description  [BUTTON]
	Gives back a table: { Frame, Description, Button, ButtonLabel }
]]
local function makeRow(list, title, description, buttonText, buttonColor, order)
	local row = UIKit.Panel(list, UDim2.new(0.97, 0, 0, 84), UDim2.new(0, 0, 0, 0), C.PanelLight)
	row.LayoutOrder = order
	row.AnchorPoint = Vector2.new(0, 0) -- the list layout places it, so measure from the top-left

	local icon = UIKit.Create("ImageLabel", { -- BLANK icon. Put an image id in Image later.
		Image = "",
		Size = UDim2.new(0, 64, 0, 64),
		Position = UDim2.new(0, 10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.Slot,
	}, row)
	UIKit.Corner(icon, 12)
	UIKit.Outline(icon, 2)

	local titleLabel = UIKit.Label(row, title, UDim2.new(0.5, 0, 0.36, 0), UDim2.new(0, 86, 0.32, 0))
	titleLabel.AnchorPoint = Vector2.new(0, 0.5) -- measure from the LEFT edge instead of the center
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left

	local descLabel = UIKit.Label(row, description, UDim2.new(0.5, 0, 0.26, 0), UDim2.new(0, 86, 0.7, 0), C.TextDim, Theme.TextFont)
	descLabel.AnchorPoint = Vector2.new(0, 0.5)
	descLabel.TextXAlignment = Enum.TextXAlignment.Left

	local button, _, buttonLabel = UIKit.Button(row, buttonText, buttonColor, UDim2.new(0.25, 0, 0.78, 0), UDim2.new(0.85, 0, 0.5, 0))

	return { Frame = row, Description = descLabel, Button = button, ButtonLabel = buttonLabel }
end

---------------------------------------------------------------------------
-- BUILD
-- actions = a table of functions ClientMain gives us:
--   actions.BuyUpgrade(upgradeId)
--   actions.HatchEgg(eggId)
--   actions.BuyPass(passId)
---------------------------------------------------------------------------
function Panels.Build(gui, actions)
	-- SHOP ---------------------------------------------------------------
	local shop, shopList = makeWindow(gui, "SHOP")
	windows.Shop = shop

	makeHeader(shopList, "UPGRADES", 1)
	for index, upgrade in ipairs(GameConfig.Upgrades) do
		local row = makeRow(shopList, upgrade.Name, upgrade.Description, "...", C.Green, 1 + index)
		row.Button.Activated:Connect(function()
			actions.BuyUpgrade(upgrade.Id)
		end)
		upgradeRows[upgrade.Id] = row
	end

	makeHeader(shopList, "GAMEPASSES", 100)
	for index, pass in ipairs(GameConfig.Gamepasses) do
		local row = makeRow(shopList, pass.Name, pass.Description, "R$ BUY", C.Gold, 100 + index)
		row.Button.Activated:Connect(function()
			actions.BuyPass(pass.PassId)
		end)
		passRows[pass.Key] = row
	end

	-- EGGS ---------------------------------------------------------------
	local eggs, eggList = makeWindow(gui, "EGGS")
	windows.Eggs = eggs

	for index, egg in ipairs(GameConfig.Eggs) do
		local currencyText = egg.Currency == "Gems" and " GEMS" or " COINS"
		local row = makeRow(eggList, egg.Name, egg.Description, Formulas.FormatNumber(egg.Price) .. currencyText, C.Green, index)
		row.Button.Activated:Connect(function()
			actions.HatchEgg(egg.Id)
		end)
	end

	makeHeader(eggList, "YOUR TEAM", 50)
	teamGrid = UIKit.Create("Frame", {
		Size = UDim2.new(0.97, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, -- grows taller as we add characters
		BackgroundTransparency = 1,
		LayoutOrder = 51,
	}, eggList)
	UIKit.Create("UIGridLayout", {
		CellSize = UDim2.new(0, 110, 0, 130),
		CellPadding = UDim2.new(0, 10, 0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, teamGrid)

	-- STORY --------------------------------------------------------------
	local story, storyList = makeWindow(gui, "STORY")
	windows.Story = story

	for index, chapter in ipairs(GameConfig.Chapters) do
		local first = (index - 1) * GameConfig.StagesPerChapter + 1 -- chapter 2 starts at stage 11
		local last = index * GameConfig.StagesPerChapter            -- and ends at stage 20
		local row = makeRow(storyList, "CH. " .. index .. "  " .. chapter.Name, "Stages " .. first .. "-" .. last .. "  |  Boss: " .. chapter.Boss, "LOCKED", C.Slot, index)
		row.Button.Active = false -- it's just a status badge, not clickable
		chapterRows[index] = { Row = row, First = first, Last = last }
	end
end

---------------------------------------------------------------------------
-- OPEN / CLOSE
---------------------------------------------------------------------------
function Panels.Open(name)
	local window = windows[name]
	if openWindow == window then -- pressing the same menu button again closes it
		Panels.Close()
		return
	end
	if openWindow then
		openWindow.Visible = false -- hide the other window first
	end
	openWindow = window
	window.Visible = true
	UIKit.Pop(window, 0.6) -- grows open with a bounce
end

function Panels.Close()
	if not openWindow then return end
	local window = openWindow
	openWindow = nil
	UIKit.Tween(UIKit.GetScale(window), 0.15, { Scale = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(0.15, function()
		if openWindow ~= window then -- it wasn't reopened in the meantime
			window.Visible = false
		end
	end)
end

---------------------------------------------------------------------------
-- UPDATE (called every time new data arrives from the server)
---------------------------------------------------------------------------

-- rebuildTeam(data): redraw the "YOUR TEAM" grid (one card per character type, with a count)
local function rebuildTeam(data)
	for _, child in ipairs(teamGrid:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy() -- remove the old cards
		end
	end

	-- count how many of each character we own. e.g. counts.NinjaKid = 3
	local counts = {}
	for _, characterId in ipairs(data.Team) do
		counts[characterId] = (counts[characterId] or 0) + 1
	end

	for order, character in ipairs(GameConfig.Characters) do
		local count = counts[character.Id]
		if count then -- only show characters we have
			local rarityColor = GameConfig.RarityColors[character.Rarity]
			local card = UIKit.Panel(teamGrid, UDim2.new(0, 0, 0, 0), UDim2.new(0, 0, 0, 0), C.PanelLight)
			card.AnchorPoint = Vector2.new(0, 0)
			card.LayoutOrder = -order -- negative = rarest (last in the list) shows FIRST
			card:FindFirstChildOfClass("UIStroke").Color = rarityColor

			local picture = UIKit.Create("ImageLabel", { -- BLANK picture
				Image = "",
				Size = UDim2.new(0.8, 0, 0.55, 0),
				Position = UDim2.new(0.5, 0, 0.36, 0),
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = C.Slot,
			}, card)
			UIKit.Corner(picture, 10)

			UIKit.Label(card, character.Name, UDim2.new(0.92, 0, 0.14, 0), UDim2.new(0.5, 0, 0.75, 0), C.Text, Theme.TextFont)
			UIKit.Label(card, "x" .. count, UDim2.new(0.5, 0, 0.13, 0), UDim2.new(0.5, 0, 0.9, 0), rarityColor)
		end
	end
end

function Panels.UpdateData(data)
	-- upgrade prices
	for _, upgrade in ipairs(GameConfig.Upgrades) do
		local row = upgradeRows[upgrade.Id]
		local timesBought = data.Upgrades[upgrade.Id] or 0
		local cost = Formulas.UpgradeCost(upgrade, timesBought)
		row.ButtonLabel.Text = Formulas.FormatNumber(cost) .. (upgrade.Currency == "Gems" and " GEMS" or "")
		row.Description.Text = upgrade.Description .. "   (owned: " .. timesBought .. ")"
	end

	-- gamepasses you own say OWNED
	for key, row in pairs(passRows) do
		if data.Passes[key] then
			row.ButtonLabel.Text = "OWNED"
			row.Button.Active = false
		end
	end

	-- story progress
	for _, info in ipairs(chapterRows) do
		local label = info.Row.ButtonLabel
		if data.Stage > info.Last then
			label.Text = "CLEARED"
			label.TextColor3 = C.Green
		elseif data.Stage >= info.First then
			label.Text = "NOW"
			label.TextColor3 = C.Gold
		else
			label.Text = "LOCKED"
			label.TextColor3 = C.TextDim
		end
	end

	rebuildTeam(data)
end

return Panels
]]></ProtectedString>
</Properties>

</Item>
<Item class="ModuleScript" referent="RBX6"><Properties>
<string name="Name">Theme</string>
<ProtectedString name="Source"><![CDATA[--[[
	Theme  (ModuleScript in StarterPlayerScripts > UI)

	The LOOK of the game in one place. Change a color or font here and
	the whole UI updates.

	The color plan (on purpose, only a few colors):
	  - Navy blues   = backgrounds, panels, cards
	  - Gold         = the main action color (ATTACK, coins, XP, titles)
	  - Green        = "buy" buttons
	  - Red          = enemy health + close buttons
	  - Cyan         = gems only
	  - White        = text, with a dark outline
]]

local Theme = {}

-- FONTS
-- Want a different style? Try Enum.Font.FredokaOne, Enum.Font.Bangers, or Enum.Font.Cartoon.
Theme.TitleFont = Enum.Font.GothamBlack -- big, heavy and bold
Theme.TextFont = Enum.Font.GothamBold   -- normal text, a bit thinner

Theme.Colors = {
	-- navy family
	BackgroundTop    = Color3.fromRGB(34, 40, 92),
	BackgroundBottom = Color3.fromRGB(18, 20, 48),
	Panel            = Color3.fromRGB(42, 50, 110),
	PanelLight       = Color3.fromRGB(62, 74, 150),
	Slot             = Color3.fromRGB(26, 30, 70),   -- empty picture slots / bar backgrounds
	Outline          = Color3.fromRGB(12, 14, 34),   -- the thick cartoon outline on EVERYTHING

	-- accents
	Gold  = Color3.fromRGB(255, 196, 46),
	Green = Color3.fromRGB(80, 214, 100),
	Red   = Color3.fromRGB(255, 76, 96),
	Cyan  = Color3.fromRGB(70, 214, 255),

	-- text
	Text    = Color3.fromRGB(255, 255, 255),
	TextDim = Color3.fromRGB(170, 180, 225),
}

Theme.OutlineThickness = 3 -- how thick the outlines are
Theme.CornerRadius = 14    -- how round the corners are (pixels)
Theme.ButtonDepth = 6      -- how "3D" buttons look (the dark part under them, in pixels)

return Theme
]]></ProtectedString>
</Properties>

</Item>
<Item class="ModuleScript" referent="RBX7"><Properties>
<string name="Name">UIKit</string>
<ProtectedString name="Source"><![CDATA[--[[
	UIKit  (ModuleScript in StarterPlayerScripts > UI)

	A toolbox for BUILDING UI pieces so the other files stay short.
	  UIKit.Create(...)  any object
	  UIKit.Label(...)   outlined text
	  UIKit.Button(...)  chunky 3D cartoon button
	  UIKit.Panel(...)   a navy box with an outline
	  UIKit.Bar(...)     health / XP bar
	  UIKit.Tween / Pop  animation helpers

	SIZES AND POSITIONS: UDim2.new(scaleX, offsetX, scaleY, offsetY)
	  scale  = a fraction of the parent (0.5 = half)
	  offset = exact pixels
	  UDim2.new(0.5, 0, 0.1, 0) = half the parent's width, 10% of its height
]]

local TweenService = game:GetService("TweenService")
local Theme = require(script.Parent.Theme) -- script.Parent = the UI folder this file is in

local UIKit = {}
local C = Theme.Colors -- short nickname so lines don't get too long

-- Create(className, properties, parent)
--   className  = what to make, e.g. "Frame", "TextLabel", "TextButton"
--   properties = a table of settings, e.g. { Text = "Hi", Size = ... }
--   parent     = what it goes inside
function UIKit.Create(className, properties, parent)
	local object = Instance.new(className)
	for name, value in pairs(properties) do
		object[name] = value -- same as writing object.Text = "Hi"
	end
	object.Parent = parent
	return object
end

-- Corner(object, radius): round the corners
function UIKit.Corner(object, radius)
	return UIKit.Create("UICorner", { CornerRadius = UDim.new(0, radius or Theme.CornerRadius) }, object)
end

-- Outline(object, thickness): thick dark border around a BOX
function UIKit.Outline(object, thickness)
	return UIKit.Create("UIStroke", {
		Thickness = thickness or Theme.OutlineThickness,
		Color = C.Outline,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, -- Border = around the box
	}, object)
end

-- TextOutline(object, thickness): thick dark border around TEXT letters
function UIKit.TextOutline(object, thickness)
	return UIKit.Create("UIStroke", {
		Thickness = thickness or 2,
		Color = C.Outline,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, -- Contextual = around the letters
	}, object)
end

-- Gradient(object, topColor, bottomColor): fade from one color to another, top to bottom
function UIKit.Gradient(object, topColor, bottomColor)
	return UIKit.Create("UIGradient", {
		Color = ColorSequence.new(topColor, bottomColor),
		Rotation = 90,
	}, object)
end

-- Lighten / Darken a color. amount 0 = same color, 1 = fully white/black
function UIKit.Lighten(color, amount)
	return color:Lerp(Color3.new(1, 1, 1), amount) -- Lerp = mix two colors
end
function UIKit.Darken(color, amount)
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

-- GetScale(object): a UIScale lets us grow/shrink something without changing its Size
function UIKit.GetScale(object)
	return object:FindFirstChildOfClass("UIScale") or UIKit.Create("UIScale", { Scale = 1 }, object)
end

-- Tween(object, seconds, goals, style, direction): smoothly animate properties
-- Example: UIKit.Tween(frame, 0.5, { BackgroundTransparency = 1 }) fades a frame out in half a second
function UIKit.Tween(object, seconds, goals, style, direction)
	local info = TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local tween = TweenService:Create(object, info, goals)
	tween:Play()
	return tween
end

-- Pop(object, startScale): "boing!" Jump to startScale, then wobble back to normal.
function UIKit.Pop(object, startScale)
	local scale = UIKit.GetScale(object)
	scale.Scale = startScale or 1.2
	UIKit.Tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
end

-- Label(parent, text, size, position, color, font): outlined text, positioned from its CENTER
function UIKit.Label(parent, text, size, position, color, font)
	local label = UIKit.Create("TextLabel", {
		Text = text,
		Size = size,
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5), -- position = the center of the label
		BackgroundTransparency = 1,          -- just text, no box
		Font = font or Theme.TitleFont,
		TextColor3 = color or C.Text,
		TextScaled = true,                   -- text grows/shrinks to fit the label
	}, parent)
	UIKit.TextOutline(label)
	return label
end

-- Panel(parent, size, position, color): a rounded box with an outline (cards, windows...)
function UIKit.Panel(parent, size, position, color)
	color = color or C.Panel
	local panel = UIKit.Create("Frame", {
		Size = size,
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1), -- white, so the gradient shows its true colors
	}, parent)
	UIKit.Corner(panel)
	UIKit.Outline(panel)
	UIKit.Gradient(panel, UIKit.Lighten(color, 0.08), color)
	return panel
end

--[[
	Button(parent, text, color, size, position)
	A chunky 3D button: a darker "base" sits under the colored "face".
	Pressing it pushes the face down onto the base, like a real button.

	Gives back THREE things:
	  face   = the TextButton (connect .Activated to this)
	  holder = the invisible frame around it (move or hide THIS one)
	  label  = the text on it (change label.Text to change the words)
]]
function UIKit.Button(parent, text, color, size, position)
	local depth = Theme.ButtonDepth

	local holder = UIKit.Create("Frame", {
		Size = size,
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
	}, parent)

	local base = UIKit.Create("Frame", { -- the dark part underneath
		Size = UDim2.new(1, 0, 1, -depth),
		Position = UDim2.new(0, 0, 0, depth),
		BackgroundColor3 = UIKit.Darken(color, 0.45),
	}, holder)
	UIKit.Corner(base)
	UIKit.Outline(base)

	local face = UIKit.Create("TextButton", { -- the colored top you click
		Size = UDim2.new(1, 0, 1, -depth),
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false, -- turn off Roblox's default grey hover
		Text = "", -- the words go in a separate label (below) so the shine can sit BEHIND them
	}, holder)
	UIKit.Corner(face)
	UIKit.Outline(face)
	UIKit.Gradient(face, UIKit.Lighten(color, 0.15), color)

	local shine = UIKit.Create("Frame", { -- the glossy white strip at the top
		Size = UDim2.new(1, -10, 0.3, 0),
		Position = UDim2.new(0, 5, 0, 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.75,
	}, face)
	UIKit.Corner(shine, 8)

	local label = UIKit.Label(face, text, UDim2.new(0.85, 0, 0.62, 0), UDim2.new(0.5, 0, 0.5, 0))
	label.ZIndex = 2 -- higher ZIndex = drawn on top (so the text is above the shine)

	-- Animations
	local scale = UIKit.GetScale(holder)
	local up = UDim2.new(0, 0, 0, 0)
	local down = UDim2.new(0, 0, 0, depth)

	face.MouseEnter:Connect(function()
		UIKit.Tween(scale, 0.15, { Scale = 1.06 }, Enum.EasingStyle.Back) -- grow a little on hover
	end)
	face.MouseLeave:Connect(function()
		UIKit.Tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
		UIKit.Tween(face, 0.08, { Position = up })
	end)
	face.MouseButton1Down:Connect(function()
		UIKit.Tween(face, 0.05, { Position = down }) -- push down onto the base
	end)
	face.MouseButton1Up:Connect(function()
		UIKit.Tween(face, 0.2, { Position = up }, Enum.EasingStyle.Back) -- spring back up
	end)

	return face, holder, label
end

--[[
	Bar(parent, size, position, color)
	A health/XP bar. Gives back a table: { Frame, Fill, Text }
	Use UIKit.SetBar(bar, 0.5, "50 / 100") to change it.
]]
function UIKit.Bar(parent, size, position, color)
	local back = UIKit.Create("Frame", {
		Size = size,
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.Slot,
	}, parent)
	UIKit.Corner(back, 10)
	UIKit.Outline(back)

	local fill = UIKit.Create("Frame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
	}, back)
	UIKit.Corner(fill, 10)
	UIKit.Gradient(fill, UIKit.Lighten(color, 0.25), color)

	local text = UIKit.Label(back, "", UDim2.new(0.95, 0, 0.75, 0), UDim2.new(0.5, 0, 0.5, 0), C.Text, Theme.TextFont)
	text.ZIndex = 2 -- draw it ON TOP of the fill

	return { Frame = back, Fill = fill, Text = text }
end

-- SetBar(bar, percent, text): percent goes from 0 (empty) to 1 (full)
function UIKit.SetBar(bar, percent, text)
	percent = math.clamp(percent, 0, 1) -- clamp = keep it between 0 and 1
	UIKit.Tween(bar.Fill, 0.2, { Size = UDim2.new(percent, 0, 1, 0) })
	bar.Fill.Visible = percent > 0 -- a 0-wide bar with round corners looks glitchy, so hide it
	bar.Text.Text = text
end

return UIKit
